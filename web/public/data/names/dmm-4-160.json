{"id":"dmm-4-160","lemma":"ἱππόφαιστον","chapter":"dmm:4.160","translit":"hippophaiston","synonyms":["ἱππόφαος","ἱπποφανής","οἱ"],"jc":[],"passages":[{"id":"dmm:4.160.1","cts":"urn:cts:greekLit:tlg0656.tlg001.1st1K-grc1:4.160.1","text":"ἱππόφαιστον· φύεται μὲν ἐν τοῖς αὐτοῖς τόποις, ἐν οἷς καὶ τὸ ἱπποφαές, καὶ αὐτὸ γναφικῆς ἀκάνθης εἶδος ὑπάρχον. ἐστι δὲ χαμαιπετές, κεφάλια μόνον ἔχον χαῦνα καὶ φυλλάρια μικρά, — οὔτε δὲ ἄνθος οὔτε καυλὸν φέρει — ῥίζαν παχεῖαν, μαλακήν. ταύτης τὰ φύλλα καὶ τὴν κεφαλὴν καὶ τὴν ῥίζαν χυλίσας ξήραινε καὶ δίδου ὁλκὴν τριωβόλου μετὰ μελικράτου, ἐφ ὧν βούλει ὕδωρ καὶ φλέγμα ἄγειν· ἰδίως δὲ ἡ διʼ αὐτοῦ κάθαρσις ὀρθοπνοίαις καὶ ἐπιλημψίαις καὶ τοῖς περὶ νεῦραπάθεσιν ἁρμόζει.","spans":["ἰδίως δὲ ἡ διʼ αὐτοῦ κάθαρσις ὀρθοπνοίαις καὶ ἐπιλημψίαις καὶ τοῖς περὶ νεῦραπάθεσιν ἁρμόζει."]}],"claims":[{"condition_text_grc":"ὀρθοπνοίαις","condition_en":"orthopnoea","plant_part":"leaf","route":null,"use_group":"RE","status":"ok","llm":false}],"candidates":[{"taxon":"gbif:3128393","name":"Centaurea spinosa","family":"Asteraceae","p":0.5552,"lo":0.3185,"hi":0.7511,"image":{"thumb":"https://commons.wikimedia.org/wiki/Special:FilePath/Centaurea%20spinosa2%20Lesbos.JPG?width=640","page":"https://commons.wikimedia.org/wiki/File:Centaurea%20spinosa2%20Lesbos.JPG"},"iucn":null,"vernacular_el":[],"sources":["lsj"],"contrib":{"f2_geo_log_occ":0.1493,"f2_present_gr":0.2092,"f3_vernacular_sim":-0.004,"f3_epithet_sim":-0.2295,"f4_lit_dmm":0.0,"f4_lit_ethno":0.0,"f4_lsj":-0.3431,"f6_genus_consensus":-0.2399,"f1_morph":-0.0298},"morph":[]},{"taxon":"__unidentified__","name":null,"family":null,"p":0.4448,"lo":0.2489,"hi":0.6815,"image":null,"iucn":null,"vernacular_el":[],"sources":[],"contrib":{},"morph":[]}],"model":"clogit_transfer_v1+f1:T=1.227","persistence":[{"use_group":"DE","present_dmm":false,"present_galen":null,"present_jc":null,"expected_modern":0.5552,"pattern":"novel"},{"use_group":"GI","present_dmm":false,"present_galen":null,"present_jc":null,"expected_m