{"id":"dmm-3-157","lemma":"κόρις","chapter":"dmm:3.157","translit":"koris","synonyms":[],"jc":[],"passages":[{"id":"dmm:3.157.1","cts":"urn:cts:greekLit:tlg0656.tlg001.1st1K-grc1:3.157.1","text":"κόρις· οἱ δὲ καὶ τοῦτο ὑπερικὸν καλοῦσι. φύλλον ἔχει παραπλήσιον τῳ τῆς ἐρείκης, μικρότερον δὲ καὶ λιπαρώτερον καὶ ἐρυθρόν· θάμνος δὲ σπιθαμιαῖος, εὔστομος, δριμύς, εὐώδης. τούτου ὁ καρπὸς πινόμενος οὖρα καὶ καταμήνια ἄγει· βοηθεῖ καὶ φαλαγγιοδήκτοις καὶ ἰσχιαδικοῖς καὶ ἀπισθοτονικοῖς σὺν αἴνῳ πινόμενος, πρὸς δὲ ῥίγη σύν πεπέρει· ἐπὶ δὲ ἀπισθοτονικῶν καὶ σύγχρισμα σὺν ἐλαίῶ ἁρμόδιον.","spans":["τούτου ὁ καρπὸς πινόμενος οὖρα καὶ καταμήνια ἄγει·","βοηθεῖ καὶ φαλαγγιοδήκτοις καὶ ἰσχιαδικοῖς καὶ ἀπισθοτονικοῖς σὺν αἴνῳ πινόμενος, πρὸς δὲ ῥίγη σύν πεπέρει·","βοηθεῖ καὶ φαλαγγιοδήκτοις καὶ ἰσχιαδικοῖς καὶ ἀπισθοτονικοῖς σὺν αἴνῳ πινόμενος, πρὸς δὲ ῥίγη σύν πεπέρει·"]}],"claims":[{"condition_text_grc":"καταμήνια","condition_en":"menses","plant_part":"fruit","route":"oral","use_group":"GY","status":"ok"},{"condition_text_grc":"ἰσχιαδικοῖς","condition_en":"sciatica","plant_part":"fruit","route":"oral","use_group":"MS","status":"ok"},{"condition_text_grc":"ῥίγη","condition_en":"shivering fits","plant_part":"fruit","route":"oral","use_group":"FV","status":"ok"}],"candidates":[{"taxon":"gbif:8411092","name":"Hypericum empetrifolium","family":"Hypericaceae","p":0.5825,"lo":0.3528,"hi":0.7596,"image":null,"iucn":null,"vernacular_el":[],"sources":["lsj"],"contrib":{"f2_geo_log_occ":0.2979,"f2_present_gr":0.2078,"f3_vernacular_sim":-0.0053,"f3_epithet_sim":-0.2501,"f4_lit_dmm":0.0,"f4_lit_ethno":0.0,"f4_lsj":-0.3502,"f6_genus_consensus":-0.2512}},{"taxon":"__unidentified__","name":null,"family":null,"p":0.4175,"lo":0.2404,"hi":0.6472,"image":null,"iucn":null,"vernacular_el":[],"sources":[],"contrib":{}}],"model":"clogit_transfer_v1:T=1.184","persistence":[{"use_group":"CV","present_dmm":false,"present_galen":null,"present_jc":null,"expected_modern":0.5825,"pattern":"novel"},{"use_group":"