{"id":"dmm-1-96","lemma":"φιλύρα","chapter":"dmm:1.96","translit":"philyra","synonyms":[],"jc":[],"passages":[{"id":"dmm:1.96.1","cts":"urn:cts:greekLit:tlg0656.tlg001.1st1K-grc1:1.96.1","text":"φιλύρα δένδρον ἐστὶν ὅμοιον κύπρῳ κατὰ μέγεθος, φύλλα δὲ ἐλαίας ὅμοια, πλατύτερα δὲ καὶ μελάντερα. καρπὸν δὲ ἔχει σχίνῳ ἐμφφερῆ, μέλανα, ὑπόγλυκυν, ὡς ἐν βότρυσι κείμενον. ἐν τραχέσι δὲ τόποις γεννᾶται. ταύτης τά φύλλα στύφει ὡς ἀγριελαία, ποιοῦντα πρὸς τὰ στύψεως δεόμενα, μάλιστα τοῖς ἐνστομίοις ἕλκεσι διαμάσημα καὶ διάκλυσμα τὸ ἀφέψημα, καὶ πινόμενον δὲ οὖρα καὶ ἔμμηνα ἄγει.","spans":["ταύτης τά φύλλα στύφει ὡς ἀγριελαία, ποιοῦντα πρὸς τὰ στύψεως δεόμενα, μάλιστα τοῖς ἐνστομίοις ἕλκεσι διαμάσημα καὶ διάκλυσμα τὸ ἀφέψημα, καὶ πινόμενον δὲ οὖρα καὶ ἔμμηνα ἄγει.","ταύτης τά φύλλα στύφει ὡς ἀγριελαία, ποιοῦντα πρὸς τὰ στύψεως δεόμενα, μάλιστα τοῖς ἐνστομίοις ἕλκεσι διαμάσημα καὶ διάκλυσμα τὸ ἀφέψημα, καὶ πινόμενον δὲ οὖρα καὶ ἔμμηνα ἄγει."]}],"claims":[{"condition_text_grc":"ἕλκεσι","condition_en":"ulcers / sores","plant_part":"leaf","route":"oral","use_group":"DE","status":"ok","llm":false},{"condition_text_grc":"ἔμμηνα","condition_en":"menses (promotes / regulates)","plant_part":"leaf","route":"oral","use_group":"GY","status":"ok","llm":false}],"candidates":[{"taxon":"gbif:3152048","name":"Tilia platyphyllos","family":"Malvaceae","p":0.3856,"lo":0.3035,"hi":0.4794,"image":{"thumb":"https://commons.wikimedia.org/wiki/Special:FilePath/L%C3%ADpa%20u%20Horn%C3%ADho%20Z%C3%A1blat%C3%AD%20v%20roce%202011%20%281%29.JPG?width=640","page":"https://commons.wikimedia.org/wiki/File:L%C3%ADpa%20u%20Horn%C3%ADho%20Z%C3%A1blat%C3%AD%20v%20roce%202011%20%281%29.JPG"},"iucn":"least concern","vernacular_el":[],"sources":["lsj"],"contrib":{"f2_geo_log_occ":-0.2351,"f2_present_gr":0.2092,"f3_vernacular_sim":-0.004,"f3_epithet_sim":-0.0782,"f4_lit_dmm":0.0,"f4_lit_ethno":0.0,"f4_lsj":-0.3431,"f6_genus_consensus":0.2161,"f1_morph":0.1114},"morph":["habit: tree ↔ tree ✓","leaf_form: entire ↔ tooth