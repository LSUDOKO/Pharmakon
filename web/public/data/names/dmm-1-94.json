{"id":"dmm-1-94","lemma":"κυνόσβατος","chapter":"dmm:1.94","translit":"kynosbatos","synonyms":[],"jc":[],"passages":[{"id":"dmm:1.94.1","cts":"urn:cts:greekLit:tlg0656.tlg001.1st1K-grc1:1.94.1","text":"κυνόσβατος· οἱ δὲ ὀξυάκανθαν καλοῦσι. θάμνος ἐστὶ βάτου πολλῷ μείζων, δενδρώδης. φύλλα φέρει πλατύτερα μυρσίνης, ἄκανθαν δὲ περὶ ταῖς ῥάβδοις ἰσχυράν, ἄνθος λευκόν, καρπὸν ἐπιμήκη, πυρῆνι ἐλαίας ἐοικότα, ἐν τῷ πεπαίνεσθαι πυρράν, τὰ δὲ ἐντὸς ἐριώδη. ἵστησι δὲ κοιλίαν ὁ καρπὸς ξηρὸς δίχα τοῦ ἐν αὐτῷ ἐριώδους — κακωτικὸν γάρ τῆς ἀρτηρίας τοῦτο — ἐν οἴνῳ ἀποζεννύμενος καὶ πινόμενος.","spans":[]}],"claims":[],"candidates":[{"taxon":"gbif:3002660","name":"Rosa sempervirens","family":"Rosaceae","p":0.6296,"lo":0.4078,"hi":0.817,"image":{"thumb":"https://commons.wikimedia.org/wiki/Special:FilePath/Rosa%20sempervirens%20L.%20%28Tlemcen%2C%20Alg%C3%A9rie%29.jpg?width=640","page":"https://commons.wikimedia.org/wiki/File:Rosa%20sempervirens%20L.%20%28Tlemcen%2C%20Alg%C3%A9rie%29.jpg"},"iucn":null,"vernacular_el":[],"sources":["lsj"],"contrib":{"f2_geo_log_occ":0.0124,"f2_present_gr":0.2092,"f3_vernacular_sim":-0.004,"f3_epithet_sim":-0.1369,"f4_lit_dmm":0.0,"f4_lit_ethno":0.0,"f4_lsj":-0.3431,"f6_genus_consensus":-0.2399,"f1_morph":0.3937},"morph":["habit: shrub ↔ climber/shrub ✓","flower_colour: white ↔ white ✓","spines: spiny ↔ spiny ✓"]},{"taxon":"__unidentified__","name":null,"family":null,"p":0.3704,"lo":0.183,"hi":0.5922,"image":null,"iucn":null,"vernacular_el":[],"sources":[],"contrib":{},"morph":[]}],"model":"clogit_transfer_v1+f1:T=1.227","persistence":[],"galen":[],"modern":[]}