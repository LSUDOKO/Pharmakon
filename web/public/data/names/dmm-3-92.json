{"id":"dmm-3-92","lemma":"ἀσκληπιάς","chapter":"dmm:3.92","translit":"asklepias","synonyms":[],"jc":[],"passages":[{"id":"dmm:3.92.1","cts":"urn:cts:greekLit:tlg0656.tlg001.1st1K-grc1:3.92.1","text":"ἀσκληπιάς· κλωνία ἀνίησι μακρά, ἐφ᾿ ὧν τὰ φύλλα κισσῷ ὅμοια, ῥίζας πολλάς, λεπτάς, εὐώδεις, ἄνθος βαρύοσμον, θπέρμα ὡς πελεκίνου φύεται ἐν ὄρεσι. βοηθοῦσι δὲ αἱ ῥίζαι σὺν οἴνῳ πινόμεναι στροφουμένοις καὶ θηριοδήκτοις καὶ τὰ φύλλα δὲ καταπλασσόμενα· ἁρμόζει καὶ πρὸς τὰ ἐν μαστοῖς καὶ μήτρᾳ κακοήθη.","spans":["βοηθοῦσι δὲ αἱ ῥίζαι σὺν οἴνῳ πινόμεναι στροφουμένοις καὶ θηριοδήκτοις καὶ τὰ φύλλα δὲ καταπλασσόμενα·","βοηθοῦσι δὲ αἱ ῥίζαι σὺν οἴνῳ πινόμεναι στροφουμένοις καὶ θηριοδήκτοις καὶ τὰ φύλλα δὲ καταπλασσόμενα·","ἁρμόζει καὶ πρὸς τὰ ἐν μαστοῖς καὶ μήτρᾳ κακοήθη."]}],"claims":[{"condition_text_grc":"στροφουμένοις","condition_en":"colic (gripings)","plant_part":"root","route":"oral","use_group":"GI","status":"ok"},{"condition_text_grc":"θηριοδήκτοις","condition_en":"bites of venomous animals","plant_part":"root","route":"oral","use_group":"DE","status":"ok"},{"condition_text_grc":"μήτρᾳ","condition_en":"womb complaints","plant_part":"root","route":null,"use_group":"GY","status":"ok"}],"candidates":[{"taxon":"gbif:5414548","name":"Vincetoxicum hirundinaria","family":"Apocynaceae","p":0.514,"lo":0.3037,"hi":0.7125,"image":{"thumb":"https://commons.wikimedia.org/wiki/Special:FilePath/Vincetoxicum%20officinale.jpg?width=640","page":"https://commons.wikimedia.org/wiki/File:Vincetoxicum%20officinale.jpg"},"iucn":null,"vernacular_el":[],"sources":["lsj"],"contrib":{"f2_geo_log_occ":-0.0302,"f2_present_gr":0.2078,"f3_vernacular_sim":-0.0053,"f3_epithet_sim":-0.2501,"f4_lit_dmm":0.0,"f4_lit_ethno":0.0,"f4_lsj":-0.3502,"f6_genus_consensus":-0.2512}},{"taxon":"__unidentified__","name":null,"family":null,"p":0.486,"lo":0.2875,"hi":0.6963,"image":null,"iucn":null,"vernacular_el":[],"sources":[],"contrib":{}}],"model":"clogit_transfer_v1:T=1.184","persistence":[{"use_group":"DE","pres