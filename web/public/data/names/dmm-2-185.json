{"id":"dmm-2-185","lemma":"ἰσάτις","chapter":"dmm:2.185","translit":"isatis","synonyms":[],"jc":[],"passages":[{"id":"dmm:2.185.1","cts":"urn:cts:greekLit:tlg0656.tlg001.1st1K-grc1:2.185.1","text":"ἰσάτις ἀγρία, παραπλήσιος οὖσα οἱ βαφεῖς χρῶνται, φύλλα ἔχει μείζονα πρὸς τὰ τῆς θρίδακος, καυλούς τε πολλούς, λεπτούς, πολυσχιδεῖς, ὑπερύθρους, ἔχοντας ἐξ ἄκρου ὥσπερ θυλάκια γλωττοειδῆ πολλὰ ἀποκρεμάμενα, ἐν οἷς τὸ σπέρμα, ἄνθος δὲ μήλινον, λεπτόν. δύναται δὲ τὰ αὐτὰ τῇ πρὸ αὐτῆς, ὠρελοῦσα καὶ σπληνικοὺς πινομένη καὶ καταπλασσομένη.","spans":["δύναται δὲ τὰ αὐτὰ τῇ πρὸ αὐτῆς, ὠρελοῦσα καὶ σπληνικοὺς πινομένη καὶ καταπλασσομένη."]}],"claims":[{"condition_text_grc":"σπληνικοὺς","condition_en":"spleen complaints","plant_part":"leaf","route":"oral","use_group":"BS","status":"ok"}],"candidates":[{"taxon":"gbif:5374118","name":"Isatis tinctoria","family":"Brassicaceae","p":0.6524,"lo":0.4595,"hi":0.77,"image":{"thumb":"https://commons.wikimedia.org/wiki/Special:FilePath/Isatis%20tinctoria02.JPG?width=640","page":"https://commons.wikimedia.org/wiki/File:Isatis%20tinctoria02.JPG"},"iucn":null,"vernacular_el":[],"sources":["lsj"],"contrib":{"f2_geo_log_occ":0.0724,"f2_present_gr":0.2078,"f3_vernacular_sim":-0.0053,"f3_epithet_sim":0.327,"f4_lit_dmm":0.0,"f4_lit_ethno":0.0,"f4_lsj":-0.3502,"f6_genus_consensus":-0.2512}},{"taxon":"__unidentified__","name":null,"family":null,"p":0.3476,"lo":0.23,"hi":0.5405,"image":null,"iucn":null,"vernacular_el":[],"sources":[],"contrib":{}}],"model":"clogit_transfer_v1:T=1.184","persistence":[{"use_group":"BS","present_dmm":true,"present_galen":null,"present_jc":null,"expected_modern":0.0,"pattern":"lost"}],"galen":[],"modern":[]}