{"id":"dmm-3-155","lemma":"ἄσκυρον","chapter":"dmm:3.155","translit":"askyron","synonyms":["ἄσκυρον","ἀσκυροειδές","ἀνδρόσαιμον"],"jc":[],"passages":[{"id":"dmm:3.155.1","cts":"urn:cts:greekLit:tlg0656.tlg001.1st1K-grc1:3.155.1","text":"ἄσκυρον· οἱ δὲ ἀσκυροειδές, οἱ δὲ ἀνδρόσαιμον. καὶ τοῦτο εἶδός ἐστιν ὑπερικοῦ μεγέθει διαφέρον, κλωσὶ μεῖζον, φρυγανωδέστερον δὲ καὶ πεφοινιγμένον· ἄνθη δὲ μήλινα φέρει, καρπὸν ὅμοιον ὑπερικῷ, ὄζοντα ῥητίνης καὶ ἐν τῳ παρατριβῆναι οἱονεὶ αἱμάσσοντα τούς δακτύλους, ὡς διὰ τοῦτο ἀνδρόσαιμον καλεῖσθαι. ποιεῖ δὲ καὶ ὁ τούτου καρπὸς πρὸς ἰσχιάδας πινόμενος μεθʼ ὑδρομέλιτος κοτυλῶν δυεῖν ἄγει δὲ χολώδη καὶ κόπρια πολλά· συνεχῶς δὲ δεῖ διδόναι, ἄχρι ἄν ὑγιασθῶσι. ποιεῖ καὶ πρὸς πυρίκαυτα ἐπιπλασθεῖσα.","spans":["ποιεῖ δὲ καὶ ὁ τούτου καρπὸς πρὸς ἰσχιάδας πινόμενος μεθʼ ὑδρομέλιτος κοτυλῶν δυεῖν ἄγει δὲ χολώδη καὶ κόπρια πολλά·","ποιεῖ καὶ πρὸς πυρίκαυτα ἐπιπλασθεῖσα."]}],"claims":[{"condition_text_grc":"ἰσχιάδας","condition_en":"sciatica","plant_part":"fruit","route":"oral","use_group":"MS","status":"ok"},{"condition_text_grc":"πυρίκαυτα","condition_en":"burns","plant_part":"fruit","route":null,"use_group":"DE","status":"ok"}],"candidates":[{"taxon":"gbif:3189486","name":"Hypericum perforatum","family":"Hypericaceae","p":0.6541,"lo":0.296,"hi":0.824,"image":{"thumb":"https://commons.wikimedia.org/wiki/Special:FilePath/%28MHNT%29%20Hypericum%20perforatum%20flower%20and%20buttons.jpg?width=640","page":"https://commons.wikimedia.org/wiki/File:%28MHNT%29%20Hypericum%20perforatum%20flower%20and%20buttons.jpg"},"iucn":null,"vernacular_el":["Βάλσαμο"],"sources":["lsj"],"contrib":{"f2_geo_log_occ":0.347,"f2_present_gr":0.2078,"f3_vernacular_sim":0.1331,"f3_epithet_sim":-0.0769,"f4_lit_dmm":0.0,"f4_lit_ethno":0.0,"f4_lsj":-0.3502,"f6_genus_consensus":-0.2512}},{"taxon":"__unidentified__","name":null,"family":null,"p":0.3459,"lo":0.176,"hi":0.704,"image":null,"iucn":null,"vernacular_el":[],"sources":[],"contrib":{}}],"model":"clogit_transfer_v1:T=1.1