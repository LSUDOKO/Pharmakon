{"id":"dmm-4-43","lemma":"φοῖνιξ","chapter":"dmm:4.43","translit":"phoinix","synonyms":[],"jc":[],"passages":[{"id":"dmm:4.43.1","cts":"urn:cts:greekLit:tlg0656.tlg001.1st1K-grc1:4.43.1","text":"φοῖνιξ· οἱ δὲ ῥοῦν, οἱ δὲ ἀγχύνωπα καλοῦσι. τὰ μὲν φύλλα ἔχει ὅμοια κριθῇ, βραχύτερα δὲ καὶ στενώτερα, στάχυν δὲ ἐμφερῆ τῇ αἴρᾳ, κλῶνας δὲ ἑξαδακτύλους κύκλῳ τῆς ῥίζης καὶ στάχυς ἑπτὰ ἢ ὀκτώ. φύεται δὲ ἐν ταῖς ἀρούραις καὶ ἐπὶ τῶν στεγῶν τῶν νεοκαταχρίστων. δύναμιν δὲ ἔχει πινόμενος ἐν οἴνῳ αὐστηρῷ διάρροιαν καὶ αἱμορραγίαν τὴν ἐκ μήτρας καὶ οὔρων πλείονα φορὰν ἱστάνειν. ἱστοροῦσι δέ τινες καὶ ἴσχαιμον αὐτὸν εἶναι ἐνδεόμενον φοινικῷ ἐρίῳ καὶ περιαπτόμενον.","spans":["δύναμιν δὲ ἔχει πινόμενος ἐν οἴνῳ αὐστηρῷ διάρροιαν καὶ αἱμορραγίαν τὴν ἐκ μήτρας καὶ οὔρων πλείονα φορὰν ἱστάνειν.","δύναμιν δὲ ἔχει πινόμενος ἐν οἴνῳ αὐστηρῷ διάρροιαν καὶ αἱμορραγίαν τὴν ἐκ μήτρας καὶ οὔρων πλείονα φορὰν ἱστάνειν.","δύναμιν δὲ ἔχει πινόμενος ἐν οἴνῳ αὐστηρῷ διάρροιαν καὶ αἱμορραγίαν τὴν ἐκ μήτρας καὶ οὔρων πλείονα φορὰν ἱστάνειν."]}],"claims":[{"condition_text_grc":"διάρροιαν","condition_en":"diarrhoea","plant_part":"leaf","route":"oral","use_group":"GI","status":"ok","llm":false},{"condition_text_grc":"αἱμορραγίαν","condition_en":"haemorrhages","plant_part":"leaf","route":"oral","use_group":"FV","status":"ok","llm":true},{"condition_text_grc":"μήτρας","condition_en":"womb complaints","plant_part":"leaf","route":"oral","use_group":"GY","status":"ok","llm":false}],"candidates":[{"taxon":"gbif:6109699","name":"Phoenix dactylifera","family":"Arecaceae","p":0.3342,"lo":0.2254,"hi":0.4546,"image":{"thumb":"https://commons.wikimedia.org/wiki/Special:FilePath/Phoenix%20dactylifera%20-%20EJ%20Burns%20-%20606494286.jpeg?width=640","page":"https://commons.wikimedia.org/wiki/File:Phoenix%20dactylifera%20-%20EJ%20Burns%20-%20606494286.jpeg"},"iucn":null,"vernacular_el":[],"sources":["lsj"],"contrib":{"f2_geo_log_occ":-0.0784,"f2_present_gr":0.2092,"f3_vernacular_sim":-0.004,"f3_epithet_sim":0.3324,"f4_li