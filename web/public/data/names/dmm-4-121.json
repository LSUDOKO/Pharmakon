{"id":"dmm-4-121","lemma":"ἴον","chapter":"dmm:4.121","translit":"ion","synonyms":[],"jc":[],"passages":[{"id":"dmm:4.121.1","cts":"urn:cts:greekLit:tlg0656.tlg001.1st1K-grc1:4.121.1","text":"ἴον· φύλλον ἔχει μικρότερον κισσοῦ καὶ λεπτότερον, μελάντερον δὲ καὶ οὐκ ἀφόμοιον, καυλίον μέσον ἀπὸ τῆς ῥίζης, ἐφʼ οὗ ἀνθύλλιον σφόδρα εὐῶδες, πορφυροῦν· φύεται ἐν παλισκίοις καὶ τραχέσι τόποις. δύναμιν δὲ ἔχει ψυκτικὴν τὰ φύλλα καταπλασσόμενα καθʼ ἑαυτὰ καὶ μετὰ ἀλφίτου· βοηθεῖ δὲ στομάχῳ πυρουμένῳ καὶ ὀφθαλμῶν φλεγμοναῖς καὶ ταῖς ἄλλαις ἕδρας προπτώσεσι. φασὶ δὲ τὸ πορφυρίζον τοῦ ἄνθους μετὰ ὕδατος ποθὲν συναγχικοῖς βοηθεῖν καὶ ἐπιληψίαις ταῖς ἐπὶ παίδων.","spans":["βοηθεῖ δὲ στομάχῳ πυρουμένῳ καὶ ὀφθαλμῶν φλεγμοναῖς καὶ ταῖς ἄλλαις ἕδρας προπτώσεσι.","βοηθεῖ δὲ στομάχῳ πυρουμένῳ καὶ ὀφθαλμῶν φλεγμοναῖς καὶ ταῖς ἄλλαις ἕδρας προπτώσεσι.","βοηθεῖ δὲ στομάχῳ πυρουμένῳ καὶ ὀφθαλμῶν φλεγμοναῖς καὶ ταῖς ἄλλαις ἕδρας προπτώσεσι.","βοηθεῖ δὲ στομάχῳ πυρουμένῳ καὶ ὀφθαλμῶν φλεγμοναῖς καὶ ταῖς ἄλλαις ἕδρας προπτώσεσι.","φασὶ δὲ τὸ πορφυρίζον τοῦ ἄνθους μετὰ ὕδατος ποθὲν συναγχικοῖς βοηθεῖν καὶ ἐπιληψίαις ταῖς ἐπὶ παίδων."]}],"claims":[{"condition_text_grc":"στομάχῳ","condition_en":"stomach complaints","plant_part":"leaf","route":null,"use_group":"GI","status":"ok"},{"condition_text_grc":"ὀφθαλμῶν","condition_en":"eye complaints","plant_part":"leaf","route":null,"use_group":"OP","status":"ok"},{"condition_text_grc":"φλεγμοναῖς","condition_en":"inflammations","plant_part":"leaf","route":null,"use_group":"DE","status":"ok"},{"condition_text_grc":"ἕδρας","condition_en":"anal complaints","plant_part":"leaf","route":null,"use_group":"GI","status":"ok"},{"condition_text_grc":"συναγχικοῖς","condition_en":"synanche (sore throat)","plant_part":"flower","route":"oral","use_group":"RL","status":"ok"}],"candidates":[{"taxon":"gbif:5331181","name":"Viola odorata","family":"Violaceae","p":0.4097,"lo":0.3538,"hi":0.4665,"image":{"thumb":"https://commons.wikimedia.org/wiki/Special:FilePath/20130407Vi