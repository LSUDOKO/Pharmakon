{"id":"dmm-3-42","lemma":"μᾶρον","chapter":"dmm:3.42","translit":"maron","synonyms":["ἕρπυλλον μέγαν καλοῦσιν","Ἀφροδίτης στέφανος","ὀριγανίδα καλοῦσιν"],"jc":[],"passages":[{"id":"dmm:3.42.1","cts":"urn:cts:greekLit:tlg0656.tlg001.1st1K-grc1:3.42.1","text":"μᾶρον ἢ ὑσόβρυον· πόα γνώριμος, φρυγανώδης, ὁμοία τῷ ἄνθει ὀριγάνῳ· τὰ μέντοι φύλλα τούτου λευκότερα πολλῷ καὶ τὸ ἄνθος εὐωδέστερον. ἔχει δὲ δύναμιν ὁμοίαν σισυμβρίῳ, ὑποστῦφον καὶ θερμαῖνον ἠρέμα, ὅθεν νομάς τε ἵστησι καταπλασσόμενον καὶ εἰς τὰ θερμαντικὰ τῶν συγχρισμάτων μείγνυται. γεννᾶται δὲ κατὰ Μαγνησίαν καὶ Τράλλεις πλεῖστον.","spans":["ἔχει δὲ δύναμιν ὁμοίαν σισυμβρίῳ, ὑποστῦφον καὶ θερμαῖνον ἠρέμα, ὅθεν νομάς τε ἵστησι καταπλασσόμενον καὶ εἰς τὰ θερμαντικὰ τῶν συγχρισμάτων μείγνυται."]}],"claims":[{"condition_text_grc":"νομάς","condition_en":"spreading ulcers (nomai)","plant_part":"leaf","route":"topical","use_group":"DE","status":"ok","llm":false}],"candidates":[{"taxon":"__unidentified__","name":null,"family":null,"p":0.8898,"lo":0.7971,"hi":0.9485,"image":null,"iucn":null,"vernacular_el":[],"sources":[],"contrib":{},"morph":[]},{"taxon":"gbif:7308317","name":"Teucrium marum","family":"Lamiaceae","p":0.1102,"lo":0.0515,"hi":0.2029,"image":null,"iucn":null,"vernacular_el":[],"sources":["lsj"],"contrib":{"f2_geo_log_occ":-0.8283,"f2_present_gr":-2.2098,"f3_vernacular_sim":-0.004,"f3_epithet_sim":0.3324,"f4_lit_dmm":0.0,"f4_lit_ethno":0.0,"f4_lsj":-0.3431,"f6_genus_consensus":-0.2399,"f1_morph":-0.0298},"morph":["leaf_surface: grey_silvery ↔ hairy ✗","smell: aromatic ↔ aromatic/pungent ✓"]}],"model":"clogit_transfer_v1+f1:T=1.227","persistence":[{"use_group":"DE","present_dmm":true,"present_galen":null,"present_jc":null,"expected_modern":0.1102,"pattern":"lost"}],"galen":[],"modern":[]}