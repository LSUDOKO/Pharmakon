{"id":"dmm-4-26","lemma":"λυκαψός","chapter":"dmm:4.26","translit":"lykapsos","synonyms":["ἄγχουσα ἑτέρα","καὶ ταύτην ἄγχουσαν καλοῦσιν"],"jc":[],"passages":[{"id":"dmm:4.26.1","cts":"urn:cts:greekLit:tlg0656.tlg001.1st1K-grc1:4.26.1","text":"λυκαψός· οἱ δὲ καὶ ταύτην ἄγχουσαν ἐκάλεσαν. τὰ μὲν φύλλα ἔχει ὅμοια θρίδακι, μακρότερα δὲ καὶ παχύτερα καἱ τραχέα, πεπτωκότα περὶ τὴν τῆς ῥίζης κεφαλήν· καυλὸν δὲ ἀνίησι μακρόν, τραχύν, ὀρθόν, παραφυάδας ἔχοντα πολλάς, πηχυαίας, τραχείας καὶ αὐτάς, ἄνθη μικρά πορφυρᾶ· ῥίζα δὲ ἐρυθρά, στυπτική· φύεται ἐν πεδίοις. καταπλαττομένη δὲ ἡ ῥίζα μετὰ ἀλφίτου ἐρυσιπέλατα ἰᾶται, λεία δὲ συναλειφομένη μετ᾿ ἐλαίου ἱδρῶτας κινεῖ.","spans":["καταπλαττομένη δὲ ἡ ῥίζα μετὰ ἀλφίτου ἐρυσιπέλατα ἰᾶται, λεία δὲ συναλειφομένη μετ᾿ ἐλαίου ἱδρῶτας κινεῖ."]}],"claims":[{"condition_text_grc":"ἐρυσιπέλατα","condition_en":"erysipelas (spreading inflammation of the skin)","plant_part":"root","route":null,"use_group":"DE","status":"ok","llm":false}],"candidates":[{"taxon":"gbif:2925889","name":"Echium italicum","family":"Boraginaceae","p":0.5976,"lo":0.3475,"hi":0.8029,"image":{"thumb":"https://commons.wikimedia.org/wiki/Special:FilePath/Echium%20italicum%200006.JPG?width=640","page":"https://commons.wikimedia.org/wiki/File:Echium%20italicum%200006.JPG"},"iucn":null,"vernacular_el":[],"sources":["lsj"],"contrib":{"f2_geo_log_occ":0.4167,"f2_present_gr":0.2092,"f3_vernacular_sim":-0.004,"f3_epithet_sim":-0.2835,"f4_lit_dmm":0.0,"f4_lit_ethno":0.0,"f4_lsj":-0.3431,"f6_genus_consensus":-0.2399,"f1_morph":-0.0298},"morph":[]},{"taxon":"__unidentified__","name":null,"family":null,"p":0.4024,"lo":0.1971,"hi":0.6525,"image":null,"iucn":null,"vernacular_el":[],"sources":[],"contrib":{},"morph":[]}],"model":"clogit_transfer_v1+f1:T=1.227","persistence":[{"use_group":"DE","present_dmm":true,"present_galen":null,"present_jc":null,"expected_modern":0.0,"pattern":"lost"}],"galen":[],"modern":[]}