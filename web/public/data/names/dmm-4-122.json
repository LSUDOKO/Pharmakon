{"id":"dmm-4-122","lemma":"κακκαλία","chapter":"dmm:4.122","translit":"kakkalia","synonyms":["δασυπόδιον","Πριαπήϊον","ἴον ἄγριον","Κυβέλειον","σεγετάλις","μουράρια","βίολα πουρπούρεα"],"jc":[],"passages":[{"id":"dmm:4.122.1","cts":"urn:cts:greekLit:tlg0656.tlg001.1st1K-grc1:4.122.1","text":"κακκαλία, οἱ δὲ λεαντικήν φύλλα φέρει λευκά, εὐμε γέθη· καυλὸς δὲ ἐξ αὐτῶν μέσος, ὀρθός, λευκός, ἄνθος ἔχων ἐοικὸς βρυωνίᾳ ἐν ὄρεσι φύεται. ταύτης ἡ ῥίζα ἐν οἴνῳ βρεχομένη ὡς τραγάκανθα καὶ ἐκλειχομένη ἢ διαμασωμένη καθʼ ἑαυτὴν βῆχας καὶ τραχύτητας ἀρτηρίας θεραπεύει· οἱ δὲ μετὰ τὴν ἐξάνθησιν ἐπιφυόμενοι κόκκοι λεῖοι ἀναληφθέντες σὺν κηρωτῇ καὶ ἐπιχρισθέντες τετανὸν καὶ ἀρρυτίδωτον τηροῦσι τὸ πρόσωπον.","spans":["ταύτης ἡ ῥίζα ἐν οἴνῳ βρεχομένη ὡς τραγάκανθα καὶ ἐκλειχομένη ἢ διαμασωμένη καθʼ ἑαυτὴν βῆχας καὶ τραχύτητας ἀρτηρίας θεραπεύει·"]}],"claims":[{"condition_text_grc":"βῆχας","condition_en":"cough","plant_part":"root","route":null,"use_group":"RE","status":"ok","llm":false}],"candidates":[{"taxon":"__unidentified__","name":null,"family":null,"p":0.6236,"lo":0.4022,"hi":0.8286,"image":null,"iucn":null,"vernacular_el":[],"sources":[],"contrib":{},"morph":[]},{"taxon":"gbif:3062973","name":"Mercurialis tomentosa","family":"Euphorbiaceae","p":0.3764,"lo":0.1714,"hi":0.5978,"image":{"thumb":"https://commons.wikimedia.org/wiki/Special:FilePath/Mercurialis%20tomentosa.jpg?width=640","page":"https://commons.wikimedia.org/wiki/File:Mercurialis%20tomentosa.jpg"},"iucn":null,"vernacular_el":[],"sources":["lsj"],"contrib":{"f2_geo_log_occ":-0.8283,"f2_present_gr":0.2092,"f3_vernacular_sim":-0.004,"f3_epithet_sim":-0.1431,"f4_lit_dmm":0.0,"f4_lit_ethno":0.0,"f4_lsj":-0.3431,"f6_genus_consensus":-0.2399,"f1_morph":-0.0298},"morph":[]}],"model":"clogit_transfer_v1+f1:T=1.227","persistence":[{"use_group":"RE","present_dmm":true,"present_galen":null,"present_jc":null,"expected_modern":0.0,"pattern":"lost"}],"galen":[],"modern":[]}