{"id":"dmm-3-116","lemma":"γεράνιον","chapter":"dmm:3.116","translit":"geranion","synonyms":[],"jc":[],"passages":[{"id":"dmm:3.116.1","cts":"urn:cts:greekLit:tlg0656.tlg001.1st1K-grc1:3.116.1","text":"γεράνιον· τὸ μὲν φύλλον ὅμοιον ἀνεμώνῃ, ἐσχισμένον, μακρότερον δέ· ῥίζαν δὲ ἔχει στρογγύλην, γλυκεῖαν, ἐσθιομένην, ἥτις ποθεῖσα σὺν οἴνῳ ὅσον δραχμῆς μιᾶς πλῆθος ὑστέρας ἐμπνευματώσεις λύει. καλεῖται δὲ ὐπʼ ἐνίων καὶ ἕτερον γεράνιον, ἔχον καυλία λεπτά, χνοώδη, δισπίθαμα, φύλλα μολόχῃ ἐμφερῆ καὶ ἐπʼ ἄκρων τῶν μασχαλῶν ἐξοχάς τινας ἀνανενευκυΐας, ὡς γεράνων κεφαλὰς σὺν τοῖς ῥάμφεσιν ἢ κυνῶν ὀδόντας. χρῆσις δʼ αὐτοῦ ἐν ἰατρικῇ οὐδεμία.","spans":["ῥίζαν δὲ ἔχει στρογγύλην, γλυκεῖαν, ἐσθιομένην, ἥτις ποθεῖσα σὺν οἴνῳ ὅσον δραχμῆς μιᾶς πλῆθος ὑστέρας ἐμπνευματώσεις λύει.","ῥίζαν δὲ ἔχει στρογγύλην, γλυκεῖαν, ἐσθιομένην, ἥτις ποθεῖσα σὺν οἴνῳ ὅσον δραχμῆς μιᾶς πλῆθος ὑστέρας ἐμπνευματώσεις λύει.","καλεῖται δὲ ὐπʼ ἐνίων καὶ ἕτερον γεράνιον, ἔχον καυλία λεπτά, χνοώδη, δισπίθαμα, φύλλα μολόχῃ ἐμφερῆ καὶ ἐπʼ ἄκρων τῶν μασχαλῶν ἐξοχάς τινας ἀνανενευκυΐας, ὡς γεράνων κεφαλὰς σὺν τοῖς ῥάμφεσιν ἢ κυνῶν ὀδόντας."]}],"claims":[{"condition_text_grc":"ὑστέρας","condition_en":"womb complaints","plant_part":"root","route":"oral","use_group":"GY","status":"ok","llm":false},{"condition_text_grc":"ἐμπνευματώσεις","condition_en":"inflations (wind)","plant_part":"root","route":"oral","use_group":"GI","status":"ok","llm":true},{"condition_text_grc":"ὀδόντας","condition_en":"teeth complaints","plant_part":"other","route":null,"use_group":"OC","status":"ambiguous","llm":false}],"candidates":[{"taxon":"gbif:9297163","name":"Erodium malacoides","family":"Geraniaceae","p":0.4549,"lo":0.3359,"hi":0.572,"image":null,"iucn":null,"vernacular_el":[],"sources":["lsj"],"contrib":{"f2_geo_log_occ":0.2503,"f2_present_gr":0.2092,"f3_vernacular_sim":-0.004,"f3_epithet_sim":0.0587,"f4_lit_dmm":0.0,"f4_lit_ethno":0.0,"f4_lsj":-0.3431,"f6_genus_consensus":-0.0119,"f1_morph":0.3937},"morph":["height: medium ↔ low/