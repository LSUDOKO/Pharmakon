{"id":"dmm-4-58","lemma":"ἀγήρατον","chapter":"dmm:4.58","translit":"ageraton","synonyms":[],"jc":[],"passages":[{"id":"dmm:4.58.1","cts":"urn:cts:greekLit:tlg0656.tlg001.1st1K-grc1:4.58.1","text":"ἀγήρατον· θάμνος φρυγανώδης, δισπίθαμος, ταπεινός, ἀπλοῦς, ἐμφερὴς μάλιστα ὀριγάνῳ, σκιάδιον ἔχων, ἐφ᾿ οὖ ἄνθος πομφολυγῶδες, χρυσοειδές, ἔλαττον δ᾿ ἑλιχρύσου. ὠνόμασται δὲ ἀγήρατον διὰ τὸ πρὸς τὸ πολὺ τὸ ἄνθος ὁμοειδὲς φυλάττεσθαι. δύναμιν δὲ ἔχει τὸ ἀφέψημα αὐτῆς πυριωμένην, καὶ αὐτὴ ἡ πόα ὑποθυμιωμένη οὖρα ἄγειν καὶ τὰ περὶ ὑστέραν μαλάττειν.","spans":["δύναμιν δὲ ἔχει τὸ ἀφέψημα αὐτῆς πυριωμένην, καὶ αὐτὴ ἡ πόα ὑποθυμιωμένη οὖρα ἄγειν καὶ τὰ περὶ ὑστέραν μαλάττειν."]}],"claims":[{"condition_text_grc":"ὑστέραν","condition_en":"womb complaints","plant_part":"whole","route":null,"use_group":"GY","status":"ok","llm":false}],"candidates":[{"taxon":"gbif:2926613","name":"Origanum onites","family":"Lamiaceae","p":0.614,"lo":0.4168,"hi":0.7818,"image":{"thumb":"https://commons.wikimedia.org/wiki/Special:FilePath/Origanum%20onites%20%27Aurea%27%20kz02.jpg?width=640","page":"https://commons.wikimedia.org/wiki/File:Origanum%20onites%20%27Aurea%27%20kz02.jpg"},"iucn":null,"vernacular_el":[],"sources":["lsj"],"contrib":{"f2_geo_log_occ":0.2958,"f2_present_gr":0.2092,"f3_vernacular_sim":-0.004,"f3_epithet_sim":-0.0782,"f4_lit_dmm":0.0,"f4_lit_ethno":0.0,"f4_lsj":-0.3431,"f6_genus_consensus":-0.2399,"f1_morph":-0.0298},"morph":[]},{"taxon":"__unidentified__","name":null,"family":null,"p":0.386,"lo":0.2182,"hi":0.5832,"image":null,"iucn":null,"vernacular_el":[],"sources":[],"contrib":{},"morph":[]}],"model":"clogit_transfer_v1+f1:T=1.227","persistence":[{"use_group":"GY","present_dmm":true,"present_galen":null,"present_jc":null,"expected_modern":0.614,"pattern":"persisted"},{"use_group":"RE","present_dmm":false,"present_galen":null,"present_jc":null,"expected_modern":0.614,"pattern":"novel"}],"galen":[{"heading":"στ΄. Περὶ ἀγηράτου.","text":"[στ΄. Περὶ ἀγηράτου.] Ἀγήρατόν ἐστι δυνάμε