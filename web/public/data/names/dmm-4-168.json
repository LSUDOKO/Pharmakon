{"id":"dmm-4-168","lemma":"πεπλίς","chapter":"dmm:4.168","translit":"peplis","synonyms":["πεπλίδα","ἴαχος","πολύγαλον","φέρομβρον","ἀνδράχνην θαλασσίαν ἢ ἀγρίαν","γαλοῦμβρον","πέπων","συκῆν","μηκώνιον","Ἡράκλειον","μήκων ἀφρώδης","προρτούλακα μίνορ","λάκτια"],"jc":[],"passages":[{"id":"dmm:4.168.1","cts":"urn:cts:greekLit:tlg0656.tlg001.1st1K-grc1:4.168.1","text":"πεπλίς· οἱ δὲ ἀνδράχνην ἀγρίαν, Ἱπποκράτης (VII L.) δὲ πέπλιον καλεῖ· φύεται μάλιστα ἐν παραθαλασσίοις τόποις θάμνος ἀμφιλαφής, ὀποῦ μεστὸς λευκοῦ, φύλλα ἔχων ὅμοια τῇ κηπαίᾳ ἀνδράχνῃ, περιφερῆ δὲ καὶ ἐκ τῶν κάτωθεν ἐνερευθῆ καὶ ὁ καρπὸς δὲ στρογγύλος, ὑποκάτω τῶν φύλλων ὥσπερ τοῦ πέπλου, πυρώδης τῇ γεύσει, ῥίζα λεπτή, μία, ἄχρηστος. συλλέγεται δὲ καὶ ἀποτίθεται καὶ δίδοται ὥσπερ ὁ πέπλος καὶ ταριχεύεται. δύναμιν δὲ ἔχει τὴν αὐτήν.","spans":[]}],"claims":[],"candidates":[{"taxon":"gbif:3066482","name":"Euphorbia peplis","family":"Euphorbiaceae","p":0.6735,"lo":0.499,"hi":0.7889,"image":{"thumb":"https://commons.wikimedia.org/wiki/Special:FilePath/Nsr-slika-124.png?width=640","page":"https://commons.wikimedia.org/wiki/File:Nsr-slika-124.png"},"iucn":null,"vernacular_el":[],"sources":["lsj"],"contrib":{"f2_geo_log_occ":0.184,"f2_present_gr":0.2078,"f3_vernacular_sim":-0.0053,"f3_epithet_sim":0.327,"f4_lit_dmm":0.0,"f4_lit_ethno":0.0,"f4_lsj":-0.3502,"f6_genus_consensus":-0.2512}},{"taxon":"__unidentified__","name":null,"family":null,"p":0.3265,"lo":0.2111,"hi":0.501,"image":null,"iucn":null,"vernacular_el":[],"sources":[],"contrib":{}}],"model":"clogit_transfer_v1:T=1.184","persistence":[],"galen":[],"modern":[]}