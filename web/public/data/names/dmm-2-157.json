{"id":"dmm-2-157","lemma":"δράβη","chapter":"dmm:2.157","translit":"drabe","synonyms":[],"jc":[],"passages":[{"id":"dmm:2.157.1","cts":"urn:cts:greekLit:tlg0656.tlg001.1st1K-grc1:2.157.1","text":"δράβη πόα πήχεως τὸ ὕψος, ῥάβδους ἔχουσα λεπτάς· παῤ ἑκάτερα δὲ τὰ φύλλα ὥσπερ λεπιδίου, ἁπαλώτερα δὲ καὶ λευκότερα, ἐπ᾿ ἄκρου δὲ σκιάδιον καθάπερ ἀκτῆς, ἔχον ἄνθη λευκά. ταύτης ἡ πόα συνέψεται πτισάνῃ, μάλιστα δ᾿ ἐν Καππαδοκίᾳ. ὁ δὲ καρπὸς αὐτῆς ξηρὸς ἀντὶ πεπέρεως μείγνυται τοῖς προσοψήμασιν.","spans":[]}],"claims":[],"candidates":[{"taxon":"gbif:5376961","name":"Lepidium draba","family":"Brassicaceae","p":0.6741,"lo":0.5235,"hi":0.801,"image":{"thumb":"https://commons.wikimedia.org/wiki/Special:FilePath/Cardaria%20draba1.jpg?width=640","page":"https://commons.wikimedia.org/wiki/File:Cardaria%20draba1.jpg"},"iucn":null,"vernacular_el":[],"sources":["lsj"],"contrib":{"f2_geo_log_occ":0.3489,"f2_present_gr":0.2078,"f3_vernacular_sim":-0.0053,"f3_epithet_sim":0.1654,"f4_lit_dmm":0.0,"f4_lit_ethno":0.0,"f4_lsj":-0.3502,"f6_genus_consensus":-0.2512}},{"taxon":"__unidentified__","name":null,"family":null,"p":0.3259,"lo":0.199,"hi":0.4765,"image":null,"iucn":null,"vernacular_el":[],"sources":[],"contrib":{}}],"model":"clogit_transfer_v1:T=1.184","persistence":[],"galen":[],"modern":[]}