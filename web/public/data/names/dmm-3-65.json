{"id":"dmm-3-65","lemma":"ὀρεοσέλινον","chapter":"dmm:3.65","translit":"oreoselinon","synonyms":["μελισσόφυλλον","αἷμα Ὥρου","ἄπιουμ","μίθ","σίληνα","πεδινόν","ὑδροσέλινον","σέλινον ἄγριον καλοῦσιν","ἄπιουμ ῥούστικουμ"],"jc":[],"passages":[{"id":"dmm:3.65.1","cts":"urn:cts:greekLit:tlg0656.tlg001.1st1K-grc1:3.65.1","text":"ὀρεοσέλινον· καυλός ἐστι σπιθαμιαῖος ἐκ ῥίζης λεπτῆς, περὶ δὲ αὐτὸν κλωνάρια καὶ κεφάλια κωνείῳ παρεμφέρῆ, λεπτότερα δὲ ἱκανῶς, ἐφ᾿ ὧν ὁ καρπὸς ἐπιμήκης, δριμύς, εὐώδης, ἐοικὼς κυμίνῳ. φύεται δὲ ἐν πέτραις καὶ ὀρεινοῖς τόποις. δύναμιν δὲ ἔχει ὁ καρπὸς καὶ ἡ ῥίζα οὐρητικὴν ποθέντα ἐν οἴνῳ· ἄγει δὲ καὶ ἔμμηνα· μείγνυται δὲ καὶ ἀντιδότοις καὶ ταῖς θερμαντικαῖς δυνάμεσιν. οὐ δεῖ δὲ πλανᾶσθαι νομίζοντας τὸ ὀρεοσέλινον ἐν πέτραις φυόμενον πετροσέλινον.","spans":["δύναμιν δὲ ἔχει ὁ καρπὸς καὶ ἡ ῥίζα οὐρητικὴν ποθέντα ἐν οἴνῳ·","ἄγει δὲ καὶ ἔμμηνα·"]}],"claims":[{"condition_text_grc":"οὐρητικὴν","condition_en":"diuretic","plant_part":"fruit","route":"oral","use_group":"UR","status":"ok"},{"condition_text_grc":"ἔμμηνα","condition_en":"menses (promotes / regulates)","plant_part":"fruit","route":null,"use_group":"GY","status":"ok"}],"candidates":[{"taxon":"gbif:7454714","name":"Bubon macedonicum","family":"Apiaceae","p":0.5339,"lo":0.3315,"hi":0.7077,"image":null,"iucn":null,"vernacular_el":[],"sources":["lsj"],"contrib":{"f2_geo_log_occ":-0.0719,"f2_present_gr":0.2078,"f3_vernacular_sim":-0.0053,"f3_epithet_sim":-0.1137,"f4_lit_dmm":0.0,"f4_lit_ethno":0.0,"f4_lsj":-0.3502,"f6_genus_consensus":-0.2512}},{"taxon":"__unidentified__","name":null,"family":null,"p":0.4661,"lo":0.2923,"hi":0.6685,"image":null,"iucn":null,"vernacular_el":[],"sources":[],"contrib":{}}],"model":"clogit_transfer_v1:T=1.184","persistence":[{"use_group":"GY","present_dmm":true,"present_galen":null,"present_jc":null,"expected_modern":0.0,"pattern":"lost"},{"use_group":"UR","present_dmm":true,"present_galen":null,"present_jc":null,"expected_modern":0.0,"pattern":"lost"}],"galen":[],"moder