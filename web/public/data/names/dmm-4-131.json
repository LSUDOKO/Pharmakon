{"id":"dmm-4-131","lemma":"κατανάγκη","chapter":"dmm:4.131","translit":"katananke","synonyms":["κατανάγκη οἱ δὲ δαμναμένη","Διονυσιάς","θύρσιον","δῆμος","κῆμος","κρότιον","ἀχαράς","ἀρκοπόδιον","ἕρβα φιλικλα","δατίοκα","Ἰόβις μάνους","καρωπίθλα"],"jc":[],"passages":[{"id":"dmm:4.131.1","cts":"urn:cts:greekLit:tlg0656.tlg001.1st1K-grc1:4.131.1","text":"κατανάγκη ἡ μέν τις ἔχει φύλλα μικρά ὡς κορωνόποδος, ῥίζαν λεπτὴν ὡς σχοίνου, κεφαλὰς δὲ ὡς ὀρόβου ἓξ ἢ ἑπτά, ἐν αἷς καρπὸς ὅμοιος ὀρόβῳ· κάμπτεται δὲ ξηραινόμενον εἰς τὴν γῆν καὶ ἰκτίνου ὄνυξιν ὁμοιοῦται νεκροῦ· τὸ δὲ ἕτερον μήλου δὲ μέγεθος μικροῦ, ῥίζαν δὲ μικρὰν ὅσον ἐλαίαν, φύλλα σχήματι καὶ χρόᾳ ἐοικότα ἐλαίᾳ, μαλακώτερα δέ, καρπὸν μικρόν, τετρημένον κατὰ πολλὰ μέρη, ὡς ἐρέβινθον, φοινικοῦν. ἀμφοτέρας ἱστοροῦσί τινες εἰς φίλτρα ἁρμόζειν, χρῆσθαι δὲ αὐταῖς τὰς Θεσσαλάς γυναῖκας.","spans":[]}],"claims":[],"candidates":[{"taxon":"gbif:5358265","name":"Ornithopus compressus","family":"Fabaceae","p":0.5699,"lo":0.3182,"hi":0.7901,"image":{"thumb":"https://commons.wikimedia.org/wiki/Special:FilePath/%28MHNT%29%20Ornithopus%20compressus%20-%20Habitus.jpg?width=640","page":"https://commons.wikimedia.org/wiki/File:%28MHNT%29%20Ornithopus%20compressus%20-%20Habitus.jpg"},"iucn":null,"vernacular_el":[],"sources":["lsj"],"contrib":{"f2_geo_log_occ":0.3092,"f2_present_gr":0.2092,"f3_vernacular_sim":-0.004,"f3_epithet_sim":-0.316,"f4_lit_dmm":0.0,"f4_lit_ethno":0.0,"f4_lsj":-0.3431,"f6_genus_consensus":-0.2399,"f1_morph":-0.0298},"morph":[]},{"taxon":"__unidentified__","name":null,"family":null,"p":0.4301,"lo":0.2099,"hi":0.6818,"image":null,"iucn":null,"vernacular_el":[],"sources":[],"contrib":{},"morph":[]}],"model":"clogit_transfer_v1+f1:T=1.227","persistence":[],"galen":[],"modern":[]}