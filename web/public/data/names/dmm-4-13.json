{"id":"dmm-4-13","lemma":"κλύμενον","chapter":"dmm:4.13","translit":"klymenon","synonyms":["στοίβιον","στίπαμ","καλυκάνθεμον","περικλύμενον","ἡλιοφυές","ἡπατῖτις","μῖλαξ","ἀνατολικόν","δυτικόν","ἀμερσίνη","οὐόλουκρουμ","οὐόλουκρουμ μάῖους","κισσοειδῆ"],"jc":[],"passages":[{"id":"dmm:4.13.1","cts":"urn:cts:greekLit:tlg0656.tlg001.1st1K-grc1:4.13.1","text":"κλύμενον· καυλὸν ἀνίησι τετράγωνον, ὅμοιον τῷ τοῦ κυάμου, φύλλα δὲ πρὸς τὰ τοῦ ἀρνογλώσσου, θυλάκια δὲ ἐπὶ τοῦ καυλοῦ εἰς ἄλληλα νεύοντα, ἐοικότα ἴριδι καὶ πολύποδος πλεκτάναις· ἄριστον δὲ τὸ ὀρεινόν. χυλίζεται δὲ ὅλον σὺν τῇ ῥίζῃ. ποιεῖ δὲ ὁ χυλὸς πρὸς αἵματος ἀναγωγάς πινόμενος καὶ κοιλιακοὺς καὶ ῥοῦν ἐρυθρόν, ψύχων καὶ στύφων· ἐπέχει δὲ καὶ τάς ἐκ μυκτήρων αἱμορραγίας. τὰ δὲ θυλάκια λεῖα τοῖς νεοτρώτοις ἐπιτιθέμενα μέχρι ἀπουλώσεως ἐνεργεῖ.","spans":["ποιεῖ δὲ ὁ χυλὸς πρὸς αἵματος ἀναγωγάς πινόμενος καὶ κοιλιακοὺς καὶ ῥοῦν ἐρυθρόν, ψύχων καὶ στύφων·"]}],"claims":[{"condition_text_grc":"κοιλιακοὺς","condition_en":"coeliac flux (chronic diarrhoea)","plant_part":"juice/sap","route":"oral","use_group":"GI","status":"ok"}],"candidates":[{"taxon":"gbif:2928390","name":"Convolvulus arvensis","family":"Convolvulaceae","p":0.5225,"lo":0.3852,"hi":0.6702,"image":{"thumb":"https://commons.wikimedia.org/wiki/Special:FilePath/00%202050%20Ackerwinde%20%28Convolvulus%20arvensis%29.jpg?width=640","page":"https://commons.wikimedia.org/wiki/File:00%202050%20Ackerwinde%20%28Convolvulus%20arvensis%29.jpg"},"iucn":null,"vernacular_el":[],"sources":["lsj"],"contrib":{"f2_geo_log_occ":0.4382,"f2_present_gr":0.2078,"f3_vernacular_sim":-0.0053,"f3_epithet_sim":-0.2258,"f4_lit_dmm":0.0,"f4_lit_ethno":0.0,"f4_lsj":-0.3502,"f6_genus_consensus":-0.0125}},{"taxon":"__unidentified__","name":null,"family":null,"p":0.2665,"lo":0.1463,"hi":0.404,"image":null,"iucn":null,"vernacular_el":[],"sources":[],"contrib":{}},{"taxon":"gbif:5358301","name":"Scorpiurus vermiculatus","family":"Fabaceae","p":0.211,"lo":0.1197,"hi":0.3243,"image":{"thumb":"htt