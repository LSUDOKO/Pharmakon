{"id":"dmm-4-117","lemma":"ὀνάγρα","chapter":"dmm:4.117","translit":"onagra","synonyms":[],"jc":[],"passages":[{"id":"dmm:4.117.1","cts":"urn:cts:greekLit:tlg0656.tlg001.1st1K-grc1:4.117.1","text":"ὀνάγρα, οἱ δὲ ὀνοθήραν, οἱ δὲ ὀνοῦριν· θάμνος ἐστὶ δενδροειδής, εὐμεγέθης, φύλλα ἔχων ἀμυγδαλῇ παραπλήσια, πλατύτερα δὲ καὶ ἐμφερῆ τοῖς τοῦ κρίνου, ἄνθη ῥοδοειδῆ, μεγάλα, ῥίζαν δὲ μακράν, λευκήν, ἥτις ξηρανθεῖσα οἴνου ὀσμὴν ἀποδίδωσι φύεται ἐν ὀρεινοῖς τόποις. δύναμιν δὲ ἔχει τὸ ἀπόβρεγμα τῆς ῥίζης ὑπὸ τῶν ἀγρίων ζῴων πινόμενον ἡμεροῦν αὐτά· καταπλασθεῖσα δὲ πραΰνει τὰ θηριώδη ἕλκη.","spans":["καταπλασθεῖσα δὲ πραΰνει τὰ θηριώδη ἕλκη."]}],"claims":[{"condition_text_grc":"ἕλκη","condition_en":"ulcers / sores","plant_part":"root","route":"topical","use_group":"DE","status":"ok"}],"candidates":[{"taxon":"gbif:3169756","name":"Nerium oleander","family":"Apocynaceae","p":0.6697,"lo":0.4606,"hi":0.8243,"image":{"thumb":"https://commons.wikimedia.org/wiki/Special:FilePath/Nerium%20oleander%20flowers%20leaves.jpg?width=640","page":"https://commons.wikimedia.org/wiki/File:Nerium%20oleander%20flowers%20leaves.jpg"},"iucn":"least concern","vernacular_el":[],"sources":["lsj"],"contrib":{"f2_geo_log_occ":0.6253,"f2_present_gr":0.2078,"f3_vernacular_sim":-0.0053,"f3_epithet_sim":-0.1346,"f4_lit_dmm":0.0,"f4_lit_ethno":0.0,"f4_lsj":-0.3502,"f6_genus_consensus":-0.2512}},{"taxon":"__unidentified__","name":null,"family":null,"p":0.3303,"lo":0.1757,"hi":0.5394,"image":null,"iucn":null,"vernacular_el":[],"sources":[],"contrib":{}}],"model":"clogit_transfer_v1:T=1.184","persistence":[{"use_group":"CV","present_dmm":false,"present_galen":null,"present_jc":null,"expected_modern":0.6697,"pattern":"novel"},{"use_group":"DE","present_dmm":true,"present_galen":null,"present_jc":null,"expected_modern":0.6697,"pattern":"persisted"},{"use_group":"FV","present_dmm":false,"present_galen":null,"present_jc":null,"expected_modern":0.6697,"pattern":"novel"},{"use_group":"GI","present_dmm":false,"present_ga