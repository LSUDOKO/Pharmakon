{"id":"dmm-4-66","lemma":"μήκων","chapter":"dmm:4.66","translit":"mekon","synonyms":["μήκων ἀφρώδης"],"jc":[],"passages":[{"id":"dmm:4.66.1","cts":"urn:cts:greekLit:tlg0656.tlg001.1st1K-grc1:4.66.1","text":"μήκων ἀφρώδης, ὑπὸ δέ τινων Ἡρακλεία κληθεῖσα, καυλίον ἔχει σπιθαμιαῖον καὶ τὸ φύλλον σφόδρα μικρόν, στρουθίῳ ἐοικὸς καὶ καρπὸν παῤ αὐτῷ λευκόν — καὶ τὸ ὅλον δὲ βοτάνιον λευκόν ἐστι καὶ ἀφρῶδες — ῥίζαν δὲ λεπτήν, ἐπιπόλαιον. ταύτης ὁ καρπὸς συλλέγεται, ὅταν τελείως ἁδρυνθῇ θέρους, καὶ ξηρανθεὶς ἀποτίθεται. καθαίρει δὲ δι᾿ ἐμέτων ὀξυβάφου πλῆθος σύν μελικράτῳ λαμβανόμενος· ἰδίως δὲ ἡ τοιαύτη κάθαρσις ἐπιληπτικοῖς ἁρμόζει.","spans":["καθαίρει δὲ δι᾿ ἐμέτων ὀξυβάφου πλῆθος σύν μελικράτῳ λαμβανόμενος·","ἰδίως δὲ ἡ τοιαύτη κάθαρσις ἐπιληπτικοῖς ἁρμόζει."]}],"claims":[{"condition_text_grc":"ἐμέτων","condition_en":"vomiting","plant_part":"fruit","route":null,"use_group":"GI","status":"ok","llm":false},{"condition_text_grc":"ἐπιληπτικοῖς","condition_en":"epilepsy","plant_part":"fruit","route":null,"use_group":"NC","status":"ok","llm":false}],"candidates":[{"taxon":"gbif:5334190","name":"Glaucium flavum","family":"Papaveraceae","p":0.2093,"lo":0.1363,"hi":0.2876,"image":{"thumb":"https://commons.wikimedia.org/wiki/Special:FilePath/Glaucium%20flavum03.jpg?width=640","page":"https://commons.wikimedia.org/wiki/File:Glaucium%20flavum03.jpg"},"iucn":null,"vernacular_el":[],"sources":["lsj"],"contrib":{"f2_geo_log_occ":0.5265,"f2_present_gr":0.2092,"f3_vernacular_sim":-0.004,"f3_epithet_sim":-0.3395,"f4_lit_dmm":0.0,"f4_lit_ethno":0.0,"f4_lsj":-0.3431,"f6_genus_consensus":-0.1487,"f1_morph":-0.1709},"morph":["height: low ↔ medium ✗","leaf_form: small ↔ lobed ✗","leaf_surface: grey_silvery ↔ grey_silvery ✓"]},{"taxon":"gbif:2888443","name":"Papaver rhoeas","family":"Papaveraceae","p":0.182,"lo":0.0804,"hi":0.2892,"image":{"thumb":"https://commons.wikimedia.org/wiki/Special:FilePath/Papaver%20rhoeas%20LC0050.jpg?width=640","page":"https://commons.wikimedia.org/wiki/File:Papaver%2