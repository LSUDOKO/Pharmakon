{"id":"dmm-4-112","lemma":"κύτισος","chapter":"dmm:4.112","translit":"kytisos","synonyms":[],"jc":[],"passages":[{"id":"dmm:4.112.1","cts":"urn:cts:greekLit:tlg0656.tlg001.1st1K-grc1:4.112.1","text":"κύτισος· θάμνος ἐστὶ λευκὸς ὅλος, ῥάβδους ἀνιεὶς πήχεως ἢ καὶ μείζονας, περὶ ἃς τὰ φύλλα ὅμοια τήλιδι ἢ λωτῷ τῷ τριφύλλῳ, μικρότερα δὲ καὶ ῥάχιν ἔχοντα μέσην, ἔν τε τῷ διατριβῆναι τοῖς δακτύλοις ὄζοντα ζωμοῦ, ἐν δὲ τῇ γεύσει ὅμοια ἐρεβίνθοις χλωροῖς. δύναμιν δὲ ἔχει τὰ φύλλα ψυκτικήν, διαφορητικὴν τῶν ἐν ἀρχῇ οἰδημάτων σὺν ἄρτῳ λεῖα καταπλασθέντα· κινεῖ δὲ καὶ οὔρησιν τὸ ἀφέψημα αὐτῶν πινόμενον. ἔνιοι δὲ φυτεύουσιν αὐτὸν παρὰ τοῖς σμήνεσιν ὡς ἐπαπτικὸν τῶν μελιττῶν.","spans":["δύναμιν δὲ ἔχει τὰ φύλλα ψυκτικήν, διαφορητικὴν τῶν ἐν ἀρχῇ οἰδημάτων σὺν ἄρτῳ λεῖα καταπλασθέντα·"]}],"claims":[{"condition_text_grc":"οἰδημάτων","condition_en":"swellings","plant_part":"leaf","route":"topical","use_group":"DE","status":"ok","llm":false}],"candidates":[{"taxon":"gbif:2965379","name":"Medicago arborea","family":"Fabaceae","p":0.571,"lo":0.414,"hi":0.736,"image":{"thumb":"https://commons.wikimedia.org/wiki/Special:FilePath/Medicago%20arborea1.jpg?width=640","page":"https://commons.wikimedia.org/wiki/File:Medicago%20arborea1.jpg"},"iucn":"least concern","vernacular_el":[],"sources":["lsj"],"contrib":{"f2_geo_log_occ":0.3864,"f2_present_gr":0.2092,"f3_vernacular_sim":-0.004,"f3_epithet_sim":-0.2699,"f4_lit_dmm":0.0,"f4_lit_ethno":0.0,"f4_lsj":-0.3431,"f6_genus_consensus":-0.0119,"f1_morph":0.3937},"morph":["habit: shrub ↔ shrub ✓","height: medium ↔ medium/tall ✓","leaf_form: compound ↔ compound ✓"]},{"taxon":"__unidentified__","name":null,"family":null,"p":0.2292,"lo":0.1165,"hi":0.3665,"image":null,"iucn":null,"vernacular_el":[],"sources":[],"contrib":{},"morph":[]},{"taxon":"gbif:5356345","name":"Laburnum anagyroides","family":"Fabaceae","p":0.1998,"lo":0.1056,"hi":0.3067,"image":{"thumb":"https://commons.wikimedia.org/wiki/Special:FilePath/Laburnum%20anagyroides%20ENBLA03.jpg?widt