{"id":"dmm-4-106","lemma":"ἄρκιον","chapter":"dmm:4.106","translit":"arkion","synonyms":[],"jc":[],"passages":[{"id":"dmm:4.106.1","cts":"urn:cts:greekLit:tlg0656.tlg001.1st1K-grc1:4.106.1","text":"ἄρκιον, οἱ δὲ προσωπίδα, οἱ δὲ προσώπιον καλοῦσιν· ὅμοια τὰ φύλλα ἔχει τοῖς τῆς κολοκύνθης, μείζονα μέντοι καὶ σκληρότερα καὶ μελάντερα, δασέα· ἄκαυλος δὲ ἡ πόα, ῥίζα μεγάλη καὶ λευκή, ἥτις βοηθεῖ ποθεῖσα δραχμῆς μιᾶς πλῆθος μετὰ στροβίλων αἱμοπτυικοῖς καὶ ἐμπυικοῖς· παύει καὶ τὰ ἐκ τῶν λυγισμῶν περὶ τὰ ἄρθρα ἀλγήματα καταπλασσομένη λεία· καὶ τὰ φύλλα δὲ ὠφελίμως ἐπὶ τῶν παλαιῶν ἑλκῶν καταπλάττεται.","spans":["ἄκαυλος δὲ ἡ πόα, ῥίζα μεγάλη καὶ λευκή, ἥτις βοηθεῖ ποθεῖσα δραχμῆς μιᾶς πλῆθος μετὰ στροβίλων αἱμοπτυικοῖς καὶ ἐμπυικοῖς·","παύει καὶ τὰ ἐκ τῶν λυγισμῶν περὶ τὰ ἄρθρα ἀλγήματα καταπλασσομένη λεία·","καὶ τὰ φύλλα δὲ ὠφελίμως ἐπὶ τῶν παλαιῶν ἑλκῶν καταπλάττεται."]}],"claims":[{"condition_text_grc":"αἱμοπτυικοῖς","condition_en":"spitting of blood","plant_part":"whole","route":"oral","use_group":"RE","status":"ok","llm":false},{"condition_text_grc":"ἀλγήματα","condition_en":"pains","plant_part":"whole","route":"topical","use_group":"FV","status":"ok","llm":true},{"condition_text_grc":"ἑλκῶν","condition_en":"ulcers / sores","plant_part":"leaf","route":null,"use_group":"DE","status":"ok","llm":false}],"candidates":[{"taxon":"gbif:7353729","name":"Arctium lappa","family":"Asteraceae","p":0.6652,"lo":0.4458,"hi":0.8091,"image":null,"iucn":null,"vernacular_el":[],"sources":["lsj"],"contrib":{"f2_geo_log_occ":-0.2023,"f2_present_gr":0.2092,"f3_vernacular_sim":-0.004,"f3_epithet_sim":0.2693,"f4_lit_dmm":0.0,"f4_lit_ethno":0.0,"f4_lsj":-0.3431,"f6_genus_consensus":-0.2399,"f1_morph":0.3937},"morph":["leaf_form: large ↔ large ✓","leaf_surface: dark_green/hairy ↔ hairy ✓"]},{"taxon":"__unidentified__","name":null,"family":null,"p":0.3348,"lo":0.1909,"hi":0.5542,"image":null,"iucn":null,"vernacular_el":[],"sources":[],"contrib":{},"morph":[]}],"model":"clogit_transfer_v1+f1:T=1.