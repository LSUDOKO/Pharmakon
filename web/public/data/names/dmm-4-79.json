{"id":"dmm-4-79","lemma":"σμῖλαξ","chapter":"dmm:4.79","translit":"smilax","synonyms":[],"jc":[],"passages":[{"id":"dmm:4.79.1","cts":"urn:cts:greekLit:tlg0656.tlg001.1st1K-grc1:4.79.1","text":"σμῖλαξ· οἱ δὲ σμῖλον, Ῥωμαῖοι δὲ τάξον καλοῦσι· δένδρον ἐστὶν ἐλάτη παραπλήσιον φύλλοις καὶ μεγέθει, ἐν Ἰταλίᾳ καὶ ἐν Ναρβωνίᾳ τῇ κατὰ τὴν Σπανίαν φυόμενον. τοῦ δʼ ἐν Ἰταλίᾳ γεννωμένου τὸν καρπὸν ὀρνύφια ἐσθίοντα πνίγεται, ἄνθρωποι δὲ προσενεγκάμενοι διαρροίαις περιπίπτουσι. τὸ δʼ ἐν τῇ Ναρβωνίᾳ τοσαύτης μετέχει δυνάμεως, ὡς καὶ ἐκ τῆς σκιᾶς τοὺς ὑποκαθίσαντας ἡ κοιμηθέντας βλάπτεσθαι, πολλάκις δὲ καὶ θνήσκειν. ἱστορεῖται δὲ περὶ αὐτῆς χάριν τοῦ προφυλάσσεσθαι.","spans":["τοῦ δʼ ἐν Ἰταλίᾳ γεννωμένου τὸν καρπὸν ὀρνύφια ἐσθίοντα πνίγεται, ἄνθρωποι δὲ προσενεγκάμενοι διαρροίαις περιπίπτουσι."]}],"claims":[{"condition_text_grc":"διαρροίαις","condition_en":"diarrhoea","plant_part":"fruit","route":"oral","use_group":"GI","status":"ambiguous"}],"candidates":[{"taxon":"gbif:5295044","name":"Smilax aspera","family":"Smilacaceae","p":0.2889,"lo":0.1901,"hi":0.4246,"image":{"thumb":"https://commons.wikimedia.org/wiki/Special:FilePath/Smilax%20aspera.jpg?width=640","page":"https://commons.wikimedia.org/wiki/File:Smilax%20aspera.jpg"},"iucn":null,"vernacular_el":[],"sources":["lsj"],"contrib":{"f2_geo_log_occ":0.4567,"f2_present_gr":0.2078,"f3_vernacular_sim":-0.0053,"f3_epithet_sim":0.327,"f4_lit_dmm":0.0,"f4_lit_ethno":0.0,"f4_lsj":-0.3502,"f6_genus_consensus":-0.1557}},{"taxon":"gbif:5350452","name":"Phaseolus vulgaris","family":"Fabaceae","p":0.2331,"lo":0.1362,"hi":0.374,"image":{"thumb":"https://commons.wikimedia.org/wiki/Special:FilePath/Snijboon%20peulen%20Phaseolus%20vulgaris.jpg?width=640","page":"https://commons.wikimedia.org/wiki/File:Snijboon%20peulen%20Phaseolus%20vulgaris.jpg"},"iucn":"least concern","vernacular_el":[],"sources":["lsj"],"contrib":{"f2_geo_log_occ":0.7799,"f2_present_gr":0.2078,"f3_vernacular_sim":-0.0053,"f3_epithet_sim":-0.2501,"f4_lit_dmm":0.0,"f4_lit_eth