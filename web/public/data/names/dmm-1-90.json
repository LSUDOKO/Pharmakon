{"id":"dmm-1-90","lemma":"ῥάμνος","chapter":"dmm:1.90","translit":"rhamnos","synonyms":[],"jc":["ράμνος","ράμνος ditto"],"passages":[{"id":"dmm:1.90.1","cts":"urn:cts:greekLit:tlg0656.tlg001.1st1K-grc1:1.90.1","text":"ῥάμνος θάμνος ἐστὶ περὶ φραγμούς φυόμενος, ῥάβδους ἔχων ὀρθὰς καὶ ἀκάνθας ὥσπερ ὀξυάκανθα, φύλλα δ᾿ ὑπομήκη, ὑπολίπαρα, μαλακά. ἔστι δὲ καὶ ἑτέρα παρά ταύτην λευκοτέρα, ἐστι καὶ τρίτη μελάντερα ἔχουσα τά φύλλα καὶ πλατύτερα σύν τῳ ἠρέμα ἐρυθραίνεσθαι, ῥάβδους μακράς πήχεων ὡς πέντε καὶ μᾶλλον ἀκανθώδεις· ἦττον δὲ στερεάς καὶ ἐπάκμους ἔχει τάς ἀκάνθας. καρπὸς δὲ πλατύς, λεπτός, ὡς θυλακώδης, ἐοικώς σφονδύλῳ.","spans":[]}],"claims":[],"candidates":[{"taxon":"gbif:6371380","name":"Rhamnus lycioides","family":"Rhamnaceae","p":0.4047,"lo":0.2787,"hi":0.5128,"image":{"thumb":"https://commons.wikimedia.org/wiki/Special:FilePath/Rhamnus%20lycioides.jpg?width=640","page":"https://commons.wikimedia.org/wiki/File:Rhamnus%20lycioides.jpg"},"iucn":null,"vernacular_el":[],"sources":["lardos"],"contrib":{"f2_geo_log_occ":0.0301,"f2_present_gr":0.2092,"f3_vernacular_sim":-0.004,"f3_epithet_sim":0.2151,"f4_lit_dmm":0.0,"f4_lit_ethno":0.0,"f4_lsj":0.2762,"f6_genus_consensus":0.0337,"f1_morph":0.3937},"morph":["habit: shrub ↔ shrub ✓","height: tall ↔ tall ✓","spines: spiny ↔ spiny ✓"]},{"taxon":"gbif:7867604","name":"Rhamnus oleoides","family":"Rhamnaceae","p":0.278,"lo":0.2112,"hi":0.3452,"image":null,"iucn":null,"vernacular_el":[],"sources":["lardos"],"contrib":{"f2_geo_log_occ":-0.0072,"f2_present_gr":0.2092,"f3_vernacular_sim":-0.004,"f3_epithet_sim":0.2151,"f4_lit_dmm":0.0,"f4_lit_ethno":0.0,"f4_lsj":0.2762,"f6_genus_consensus":0.0337,"f1_morph":-0.0298},"morph":[]},{"taxon":"gbif:3875697","name":"Rhamnus punctata","family":"Rhamnaceae","p":0.1172,"lo":0.0643,"hi":0.1763,"image":null,"iucn":null,"vernacular_el":[],"sources":["lsj"],"contrib":{"f2_geo_log_occ":-0.4474,"f2_present_gr":0.2092,"f3_vernacular_sim":-0.004,"f3_epithet_sim":0.2151,"f4_lit_dmm":0.0,"f4_lit_e