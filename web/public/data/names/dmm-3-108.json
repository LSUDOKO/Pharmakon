{"id":"dmm-3-108","lemma":"φαλάγγιον","chapter":"dmm:3.108","translit":"phalangion","synonyms":[],"jc":[],"passages":[{"id":"dmm:3.108.1","cts":"urn:cts:greekLit:tlg0656.tlg001.1st1K-grc1:3.108.1","text":"φαλάγγιον· οἱ δὲ φαλαγγῖτιν, οἱ δὲ καὶ ταύτην λευκάκανθον καλοῦσι. κλῶνές εἰσι δύο ἡ τρεῖς ἢ πλείονες, διέχοντες ἀπ᾿ ἀλλήλων, ἄνθη λευκά, παραπλήσια κρίνῳ, ἐντομὰς πολλὰς ἔχοντα· σπέρμα δὲ πλατύ, μέλαν, ὥσπερ φακοῦ ἥμισυ, ἰσχνότερον μέντοι πολλῷ, ῥιζίον μικρόν, λεπτόν, χλωρὸν ἅμα τῷ ἑλκυσθῆναι ἐκ τῆς γῆς· ὕστερον γὰρ συνέλκεται· φύεται ἐν γεωλόφοις. ταύτης τὰ φύλλα καὶ τὸ σπέρμα καὶ τὸ ἄνθος πινόμενα μετ᾿ οἴνου βοηθεῖ σκορπιοπλήκτοις καὶ φαλαγγιοδήκτοις· λύει δὲ καὶ στρόφους.","spans":["ὕστερον γὰρ συνέλκεται·","λύει δὲ καὶ στρόφους."]}],"claims":[{"condition_text_grc":"ὕστερον","condition_en":"womb complaints","plant_part":"seed","route":null,"use_group":"GY","status":"ambiguous"},{"condition_text_grc":"στρόφους","condition_en":"colic (gripings)","plant_part":"leaf","route":null,"use_group":"GI","status":"ok"}],"candidates":[{"taxon":"gbif:9343583","name":"Gagea graeca","family":"Liliaceae","p":0.6435,"lo":0.3973,"hi":0.8188,"image":null,"iucn":null,"vernacular_el":[],"sources":["lsj"],"contrib":{"f2_geo_log_occ":0.3026,"f2_present_gr":0.2078,"f3_vernacular_sim":-0.0053,"f3_epithet_sim":-0.2655,"f4_lit_dmm":0.0,"f4_lit_ethno":0.0,"f4_lsj":-0.0342,"f6_genus_consensus":-0.2512}},{"taxon":"__unidentified__","name":null,"family":null,"p":0.3565,"lo":0.1812,"hi":0.6027,"image":null,"iucn":null,"vernacular_el":[],"sources":[],"contrib":{}}],"model":"clogit_transfer_v1:T=1.184","persistence":[{"use_group":"GI","present_dmm":true,"present_galen":null,"present_jc":null,"expected_modern":0.0,"pattern":"lost"}],"galen":[],"modern":[]}