{"id":"dmm-3-108","lemma":"φαλάγγιον","chapter":"dmm:3.108","translit":"phalangion","synonyms":[],"jc":[],"passages":[{"id":"dmm:3.108.1","cts":"urn:cts:greekLit:tlg0656.tlg001.1st1K-grc1:3.108.1","text":"φαλάγγιον· οἱ δὲ φαλαγγῖτιν, οἱ δὲ καὶ ταύτην λευκάκανθον καλοῦσι. κλῶνές εἰσι δύο ἡ τρεῖς ἢ πλείονες, διέχοντες ἀπ᾿ ἀλλήλων, ἄνθη λευκά, παραπλήσια κρίνῳ, ἐντομὰς πολλὰς ἔχοντα· σπέρμα δὲ πλατύ, μέλαν, ὥσπερ φακοῦ ἥμισυ, ἰσχνότερον μέντοι πολλῷ, ῥιζίον μικρόν, λεπτόν, χλωρὸν ἅμα τῷ ἑλκυσθῆναι ἐκ τῆς γῆς· ὕστερον γὰρ συνέλκεται· φύεται ἐν γεωλόφοις. ταύτης τὰ φύλλα καὶ τὸ σπέρμα καὶ τὸ ἄνθος πινόμενα μετ᾿ οἴνου βοηθεῖ σκορπιοπλήκτοις καὶ φαλαγγιοδήκτοις· λύει δὲ καὶ στρόφους.","spans":["φαλάγγιον·","ὕστερον γὰρ συνέλκεται·","ταύτης τὰ φύλλα καὶ τὸ σπέρμα καὶ τὸ ἄνθος πινόμενα μετ᾿ οἴνου βοηθεῖ σκορπιοπλήκτοις καὶ φαλαγγιοδήκτοις·","ταύτης τὰ φύλλα καὶ τὸ σπέρμα καὶ τὸ ἄνθος πινόμενα μετ᾿ οἴνου βοηθεῖ σκορπιοπλήκτοις καὶ φαλαγγιοδήκτοις·","λύει δὲ καὶ στρόφους."]}],"claims":[{"condition_text_grc":"φαλάγγιον","condition_en":"bites of venomous spiders (phalangia)","plant_part":null,"route":null,"use_group":"DE","status":"ambiguous","llm":true},{"condition_text_grc":"ὕστερον","condition_en":"womb complaints","plant_part":"seed","route":null,"use_group":"GY","status":"ambiguous","llm":false},{"condition_text_grc":"σκορπιοπλήκτοις","condition_en":"scorpion stings","plant_part":"leaf","route":"oral","use_group":"DE","status":"ok","llm":true},{"condition_text_grc":"φαλαγγιοδήκτοις","condition_en":"bites of venomous spiders (phalangia)","plant_part":"leaf","route":"oral","use_group":"DE","status":"ok","llm":true},{"condition_text_grc":"στρόφους","condition_en":"colic (gripings)","plant_part":"leaf","route":null,"use_group":"GI","status":"ok","llm":false}],"candidates":[{"taxon":"gbif:9343583","name":"Gagea graeca","family":"Liliaceae","p":0.6382,"lo":0.3916,"hi":0.8182,"image":null,"iucn":null,"vernacular_el":[],"sources":["lsj"],"contrib":{"f2_geo_log_occ":0.3045,"f2_prese