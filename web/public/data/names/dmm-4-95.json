{"id":"dmm-4-95","lemma":"γάλιον","chapter":"dmm:4.95","translit":"galion","synonyms":["γαλαίριον"],"jc":[],"passages":[{"id":"dmm:4.95.1","cts":"urn:cts:greekLit:tlg0656.tlg001.1st1K-grc1:4.95.1","text":"γάλιον· οἱ δὲ γαλαίριον, οἱ δὲ γαλάτιον· ὠνόμασται ἀπὸ τοῦ γάλα πηγνύειν ἀντὶ πυτίας αὐτό. τὸ δὲ κλωνίον καὶ τὸ φύλλον ἔχει ἐμφερέστατον ἀπαρίνῃ, ὀρθὸν δέ, καὶ ἐπʼ ἄκρου ἄνθος μήλινον, λεπτόν, πυκνόν, πολύοσμον· οὗ τὸ ἄνθος πρὸς τὰ πυρίκαυτα καταπλάττεται καὶ αἱμορραγίαις ἁρμόζει· μείγνυται καὶ κηρωτῇ ῥοδίνῃ ἡλιαζόμενον, ἄχρις ἂν λευκὸν γένηται, καὶ ἔστι τὸ τοιοῦτον ἄκοπον. ἡ δὲ ῥίζα πρὸς συνουσίαν παρορμᾷ. φύεται δὲ ἐν ἑλώδεσι τόποις.","spans":["οὗ τὸ ἄνθος πρὸς τὰ πυρίκαυτα καταπλάττεται καὶ αἱμορραγίαις ἁρμόζει·","οὗ τὸ ἄνθος πρὸς τὰ πυρίκαυτα καταπλάττεται καὶ αἱμορραγίαις ἁρμόζει·"]}],"claims":[{"condition_text_grc":"πυρίκαυτα","condition_en":"burns","plant_part":"flower","route":null,"use_group":"DE","status":"ok","llm":false},{"condition_text_grc":"αἱμορραγίαις","condition_en":"haemorrhages","plant_part":"flower","route":null,"use_group":"FV","status":"ok","llm":true}],"candidates":[{"taxon":"gbif:9063248","name":"Galium verum","family":"Rubiaceae","p":0.7518,"lo":0.5548,"hi":0.8615,"image":null,"iucn":null,"vernacular_el":[],"sources":["lsj"],"contrib":{"f2_geo_log_occ":0.252,"f2_present_gr":0.2092,"f3_vernacular_sim":-0.004,"f3_epithet_sim":0.3324,"f4_lit_dmm":0.0,"f4_lit_ethno":0.0,"f4_lsj":-0.3431,"f6_genus_consensus":-0.2399,"f1_morph":0.3937},"morph":["flower_colour: yellow ↔ yellow ✓"]},{"taxon":"__unidentified__","name":null,"family":null,"p":0.2482,"lo":0.1385,"hi":0.4452,"image":null,"iucn":null,"vernacular_el":[],"sources":[],"contrib":{},"morph":[]}],"model":"clogit_transfer_v1+f1:T=1.227","persistence":[{"use_group":"DE","present_dmm":true,"present_galen":null,"present_jc":null,"expected_modern":0.0,"pattern":"lost"},{"use_group":"FV","present_dmm":true,"present_galen":null,"present_jc":null,"expected_modern":0.0,"pattern":"lost"}],"galen":[],"m