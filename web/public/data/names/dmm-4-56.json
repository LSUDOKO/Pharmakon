{"id":"dmm-4-56","lemma":"χρυσόγονον","chapter":"dmm:4.56","translit":"chrysogonon","synonyms":[],"jc":[],"passages":[{"id":"dmm:4.56.1","cts":"urn:cts:greekLit:tlg0656.tlg001.1st1K-grc1:4.56.1","text":"χρυσόγονον· οἱ δὲ ἴασπιν, οἱ δὲ λίνον καλοῦσι. φύλλα μὲν ἔχει ὅμοια δρυΐ — ὁ δὲ θάμνος ἐστὶ πυκνός — ἄνθος δὲ παραπλήσιον φλόμῳ τῷ στεφανωματικῷ, ῥίζαν δὲ ὁμοίαν γογγυλίδι, ἔνδοθεν ἰσχυρῶς ἐρυθράν, ἔξωθεν δὲ μέλαιναν, ἥτις βοηθεῖ σύν ὄξει λεανθεῖσα καὶ ἐπιτεθεῖσα μυγαλῆς δήγμασιν.","spans":["φύλλα μὲν ἔχει ὅμοια δρυΐ — ὁ δὲ θάμνος ἐστὶ πυκνός — ἄνθος δὲ παραπλήσιον φλόμῳ τῷ στεφανωματικῷ, ῥίζαν δὲ ὁμοίαν γογγυλίδι, ἔνδοθεν ἰσχυρῶς ἐρυθράν, ἔξωθεν δὲ μέλαιναν, ἥτις βοηθεῖ σύν ὄξει λεανθεῖσα καὶ ἐπιτεθεῖσα μυγαλῆς δήγμασιν."]}],"claims":[{"condition_text_grc":"δήγμασιν","condition_en":"bites","plant_part":"leaf","route":"topical","use_group":"DE","status":"ok","llm":false}],"candidates":[{"taxon":"gbif:3981547","name":"Bongardia chrysogonum","family":"Berberidaceae","p":0.6009,"lo":0.3922,"hi":0.7414,"image":{"thumb":"https://commons.wikimedia.org/wiki/Special:FilePath/Bongardia%20chrysogonum%20-%20Flickr%20-%20peganum.jpg?width=640","page":"https://commons.wikimedia.org/wiki/File:Bongardia%20chrysogonum%20-%20Flickr%20-%20peganum.jpg"},"iucn":null,"vernacular_el":[],"sources":["lsj"],"contrib":{"f2_geo_log_occ":-0.1824,"f2_present_gr":0.2092,"f3_vernacular_sim":-0.004,"f3_epithet_sim":0.3324,"f4_lit_dmm":0.0,"f4_lit_ethno":0.0,"f4_lsj":-0.3431,"f6_genus_consensus":-0.2399,"f1_morph":-0.0298},"morph":[]},{"taxon":"__unidentified__","name":null,"family":null,"p":0.3991,"lo":0.2586,"hi":0.6078,"image":null,"iucn":null,"vernacular_el":[],"sources":[],"contrib":{},"morph":[]}],"model":"clogit_transfer_v1+f1:T=1.227","persistence":[{"use_group":"DE","present_dmm":true,"present_galen":null,"present_jc":null,"expected_modern":0.0,"pattern":"lost"}],"galen":[],"modern":[]}