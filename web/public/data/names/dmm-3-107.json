{"id":"dmm-3-107","lemma":"φυλλῖτις","chapter":"dmm:3.107","translit":"phyllitis","synonyms":["σταχυῖτις","τριπόλιον","τριφάριουμ","φυλλίς","ἄκαυλον","λάπαθον ἄγριον καλοῦσιν"],"jc":[],"passages":[{"id":"dmm:3.107.1","cts":"urn:cts:greekLit:tlg0656.tlg001.1st1K-grc1:3.107.1","text":"φυλλῖτις· φύλλα ἀνίησιν ὅμοια λαπάθῳ ἐπιμηκέστερα δὲ καὶ εὐθαλέστερα, ἓξ ἢ ἑπτά, ὀρθά, λεῖα ἐκ τῶν ἐντός, ἐκ δὲ τῶν ὄπισθεν καθάπερ σκώληκας ἔχοντα λεπτούς, ἐπηρτημένους· φύεται ἐν παλισκίοις καὶ παραδείσοις, γευσαμένῳ στρυφνή· οὔτε δὲ ἄνθος οὔτε καυλὸν οὔτε καρπὸν φέρει. ταύτης τὰ φύλλα μετʼ οἴνου πινόμενα πρὸς ἑρπετοδήκτους ποιεῖ. ἐπὶ τετραπόδων δὲ διὰ στόματος ἐγχυματισθεῖσα βοηθεῖ· πίνεται καὶ πρὸς δυσεντερίαν καὶ διάρροιαν.","spans":["ταύτης τὰ φύλλα μετʼ οἴνου πινόμενα πρὸς ἑρπετοδήκτους ποιεῖ.","πίνεται καὶ πρὸς δυσεντερίαν καὶ διάρροιαν.","πίνεται καὶ πρὸς δυσεντερίαν καὶ διάρροιαν."]}],"claims":[{"condition_text_grc":"ἑρπετοδήκτους","condition_en":"bites of reptiles (snakes)","plant_part":"leaf","route":"oral","use_group":"DE","status":"ok","llm":true},{"condition_text_grc":"δυσεντερίαν","condition_en":"dysentery","plant_part":"leaf","route":"oral","use_group":"GI","status":"ok","llm":false},{"condition_text_grc":"διάρροιαν","condition_en":"diarrhoea","plant_part":"leaf","route":"oral","use_group":"GI","status":"ok","llm":false}],"candidates":[{"taxon":"gbif:2650669","name":"Asplenium scolopendrium","family":"Aspleniaceae","p":0.6219,"lo":0.3904,"hi":0.8238,"image":{"thumb":"https://commons.wikimedia.org/wiki/Special:FilePath/Asplenium%20scolopendrium%20ssp.%20scolopendrium%2020150705%20110346%20%2818816757464%29.jpg?width=640","page":"https://commons.wikimedia.org/wiki/File:Asplenium%20scolopendrium%20ssp.%20scolopendrium%2020150705%20110346%20%2818816757464%29.jpg"},"iucn":null,"vernacular_el":[],"sources":["lsj"],"contrib":{"f2_geo_log_occ":0.0501,"f2_present_gr":0.2092,"f3_vernacular_sim":-0.004,"f3_epithet_sim":-0.2151,"f4_lit_dmm":0.0,"f4_lit_ethno":0.0,"f4_lsj":-0.3431,"f