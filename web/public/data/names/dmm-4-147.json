{"id":"dmm-4-147","lemma":"χαμαιδάφνη","chapter":"dmm:4.147","translit":"chamaidaphne","synonyms":[],"jc":["χαμαίδαφνη"],"passages":[{"id":"dmm:4.147.1","cts":"urn:cts:greekLit:tlg0656.tlg001.1st1K-grc1:4.147.1","text":"χαμαιδάφνη· οἱ δὲ καὶ ταύτην Ἀλεξάνδρειαν καλοῦσι. ῥάβδους ἀνίησι πηχυαίας, μονοκλώνους, λεπτάς καὶ λείας· καὶ ταύτης δὲ τὰ φύλλα ὅμοια δάφνῃ, λεπτότερα δὲ πολλῷ καὶ χλωρότερα· καρπὸν δὲ περιφερῆ, ἐρυθρόν, τοῖς φύλλοις ἐπιπεφυκότα. ταύτης τὰ φύλλα λεῖα καταπλασθέντα κεφαλαλγίαν καὶ καῦσον στομάχου παραιτεῖται, ποθέντα δὲ μετʼ οἴνου στρόφους.","spans":["ταύτης τὰ φύλλα λεῖα καταπλασθέντα κεφαλαλγίαν καὶ καῦσον στομάχου παραιτεῖται, ποθέντα δὲ μετʼ οἴνου στρόφους.","ταύτης τὰ φύλλα λεῖα καταπλασθέντα κεφαλαλγίαν καὶ καῦσον στομάχου παραιτεῖται, ποθέντα δὲ μετʼ οἴνου στρόφους.","ταύτης τὰ φύλλα λεῖα καταπλασθέντα κεφαλαλγίαν καὶ καῦσον στομάχου παραιτεῖται, ποθέντα δὲ μετʼ οἴνου στρόφους."]}],"claims":[{"condition_text_grc":"κεφαλαλγίαν","condition_en":"headache","plant_part":"leaf","route":"topical","use_group":"NC","status":"ambiguous"},{"condition_text_grc":"στομάχου","condition_en":"stomach complaints","plant_part":"leaf","route":"topical","use_group":"GI","status":"ambiguous"},{"condition_text_grc":"στρόφους","condition_en":"colic (gripings)","plant_part":"leaf","route":"topical","use_group":"GI","status":"ambiguous"}],"candidates":[{"taxon":"gbif:3169710","name":"Vinca herbacea","family":"Apocynaceae","p":0.2771,"lo":0.1943,"hi":0.3806,"image":{"thumb":"https://commons.wikimedia.org/wiki/Special:FilePath/Vinca%20herbacea%20sl6.jpg?width=640","page":"https://commons.wikimedia.org/wiki/File:Vinca%20herbacea%20sl6.jpg"},"iucn":null,"vernacular_el":[],"sources":["lsj"],"contrib":{"f2_geo_log_occ":0.1655,"f2_present_gr":0.2078,"f3_vernacular_sim":-0.0053,"f3_epithet_sim":-0.1577,"f4_lit_dmm":0.0,"f4_lit_ethno":0.0,"f4_lsj":-0.3502,"f6_genus_consensus":-0.092}},{"taxon":"gbif:5303891","name":"Danae racemosa","family":"Asparagaceae","p":0.2756,"lo":0.194