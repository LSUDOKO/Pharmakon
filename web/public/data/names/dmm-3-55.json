{"id":"dmm-3-55","lemma":"σίνων","chapter":"dmm:3.55","translit":"sinon","synonyms":[],"jc":[],"passages":[{"id":"dmm:3.55.1","cts":"urn:cts:greekLit:tlg0656.tlg001.1st1K-grc1:3.55.1","text":"σίνων· σπερμάτιόν ἐστιν ἐν Συρίᾳ γεννώμενον, παρεοικὸς σελίνῳ, ἐπίμηκες, μέλαν, πυρωτικόν, πινόμενον πρὸς σπλῆνας καὶ δυσουρίας καὶ ἐμμήνων ἐποχήν. χρῶνται δὲ αὐτῷ οἱ ἐπιχώριοι ἀρτύματι μετὰ κολοκύνθης ἑφθῆς σὺν ὄξει λαμβάνοντες.","spans":["σπερμάτιόν ἐστιν ἐν Συρίᾳ γεννώμενον, παρεοικὸς σελίνῳ, ἐπίμηκες, μέλαν, πυρωτικόν, πινόμενον πρὸς σπλῆνας καὶ δυσουρίας καὶ ἐμμήνων ἐποχήν.","σπερμάτιόν ἐστιν ἐν Συρίᾳ γεννώμενον, παρεοικὸς σελίνῳ, ἐπίμηκες, μέλαν, πυρωτικόν, πινόμενον πρὸς σπλῆνας καὶ δυσουρίας καὶ ἐμμήνων ἐποχήν.","σπερμάτιόν ἐστιν ἐν Συρίᾳ γεννώμενον, παρεοικὸς σελίνῳ, ἐπίμηκες, μέλαν, πυρωτικόν, πινόμενον πρὸς σπλῆνας καὶ δυσουρίας καὶ ἐμμήνων ἐποχήν."]}],"claims":[{"condition_text_grc":"σπλῆνας","condition_en":"spleen complaints","plant_part":"seed","route":"oral","use_group":"BS","status":"ok"},{"condition_text_grc":"δυσουρίας","condition_en":"painful urination","plant_part":"seed","route":"oral","use_group":"UR","status":"ok"},{"condition_text_grc":"ἐμμήνων","condition_en":"menses (promotes / regulates)","plant_part":"seed","route":"oral","use_group":"GY","status":"ok"}],"candidates":[{"taxon":"gbif:3641433","name":"Sison amomum","family":"Apiaceae","p":0.5091,"lo":0.2778,"hi":0.6751,"image":{"thumb":"https://commons.wikimedia.org/wiki/Special:FilePath/Neuch%C3%A2tel%20Herbarium%20-%20Sison%20amomum%20-%20NEU000007766.jpg?width=640","page":"https://commons.wikimedia.org/wiki/File:Neuch%C3%A2tel%20Herbarium%20-%20Sison%20amomum%20-%20NEU000007766.jpg"},"iucn":null,"vernacular_el":[],"sources":["lsj"],"contrib":{"f2_geo_log_occ":-0.4689,"f2_present_gr":0.2078,"f3_vernacular_sim":-0.0053,"f3_epithet_sim":0.1654,"f4_lit_dmm":0.0,"f4_lit_ethno":0.0,"f4_lsj":-0.3502,"f6_genus_consensus":-0.2512}},{"taxon":"__unidentified__","name":null,"family":null,"p":0.4909,"lo":0.3249,