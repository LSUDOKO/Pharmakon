  <data key="d3">CLAIMS_USE_FOR</data>
  <data key="d4">leaf</data>
  <data key="d5">nan</data>
  <data key="d6">καθ᾿ ἑαυτὰς δὲ ἑψηθεῖσαι αἱ κωδύαι ἐν ὕδατι ἄχρι ἡμίσους, εἶτα σὺν μέλιτι πάλιν ἑψηθεῖσαι, μέχρι ἂν συστραφῇ τὸ ὑγρόν, ποιοῦσι φάρμακον ἐκλεικτὸν ἀνώδυνον πρὸς βῆχας καὶ ῥευματισμούς ἀρτηρίας καὶ κοιλιακάς διαθέσεις·</data>
  <data key="d7">4fe9cbab63717fe9</data>
</edge>
