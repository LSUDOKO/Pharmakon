  <data key="d4">juice/sap</data>
  <data key="d5">nan</data>
  <data key="d6">ὅθεν καὶ χυλιζομένη μειγνυμένη τε ὀροβίνῳ ἀλεύρῳ καὶ ἀναπλασσομένη εἰς ἀρτίσκους δίδοται σὺν ὑδρομέλιτι σπληνικοῖς καὶ ὑδρωπικοῖς ὠφελίμως.</data>
  <data key="d7">b0f961223fb9475f</data>
</edge>
<edge source="cl:dmm:2.172" target="gbif:2853283" id="IDENTIFIED_AS">
  <data key="d3">IDENTIFIED_AS</data>
