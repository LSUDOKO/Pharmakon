  <data key="d4">oil</data>
  <data key="d9">topical</data>
  <data key="d6">τὸ δὲ ἀπ᾿ αὐτῆς ἔλαιον μετὰ μυρσίνης σμήχει τρίχας οὐλάς τε τὰς ἐν αἰδοίοις.</data>
  <data key="d7">13a0a8c3387635a3</data>
</edge>
