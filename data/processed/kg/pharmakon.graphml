<edge source="cl:dmm:2.85" target="ug:DE" id="CLAIMS_USE_FOR:c5133fc3446ce43a">
  <data key="d3">CLAIMS_USE_FOR</data>
  <data key="d8">nan</data>
  <data key="d9">topical</data>
  <data key="d6">τὸ δʼ ἐκ τῶν σητανίων πυρῶν ἄλευρον ἰοβόλοις ἁρμόζει καταπλασσόμενον σὺν ὄξει ἢ οἴνῳ, ἑψηθὲν δὲ κόλλης τρόπον καὶ ἐκλειχόμενον αἱμοπτυικοὺς ὠφελεῖ, καὶ πρὸς βῆχας καὶ ἀρτηρίας τραχυσμούς σύν ἡδυόσμῳ καὶ βουτύρῳ ἑψηθὲν ποιεῖ·</data>
  <data key="d7">c5133fc3446ce43a</data>
</edge>
<edge source="cl:dmm:2.85" target="ug:DE" id="CLAIMS_USE_FOR:4c7da366c8f0b603">
