</edge>
<edge source="cl:dmm:4.15" target="ug:UR" id="CLAIMS_USE_FOR:815bae9a4184c4ea">
  <data key="d3">CLAIMS_USE_FOR</data>
  <data key="d4">fruit</data>
  <data key="d9">oral</data>
  <data key="d6">ὁ δὲ καρπὸς αὐτῶν χλωρὸς καὶ λιθιῶντας πινόμενος ὠφελεῖ.</data>
  <data key="d7">815bae9a4184c4ea</data>
</edge>
<edge source="cl:dmm:4.15" target="ug:XY" id="CLAIMS_USE_FOR:d77609295ee3f283">
  <data key="d3">CLAIMS_USE_FOR</data>
  <data key="d4">fruit</data>
  <data key="d9">oral</data>
  <data key="d6">τοῦ δὲ χερσαίου ὅσον δραχμὴ μία πινομένη καὶ καταπλασσομένη τοὺς ἐχιοδήκτους ἀποκαθίστησιν, ἁρμόζει καὶ θανασίμοις μετʼ οἴνου πινόμενος·</data>
  <data key="d7">d77609295ee3f283</data>
</edge>
