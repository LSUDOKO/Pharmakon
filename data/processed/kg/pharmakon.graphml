  <data key="d4">seed</data>
  <data key="d5">nan</data>
  <data key="d6">τὸ δὲ σπέρμα εἰς ἀντιδότους καὶ θηριακάς ἀνωδύνους εὔθετον, βοηθεῖ δὲ καὶ τοῖς θανασίμοις·</data>
  <data key="d7">dc21c2a74f17f5e6</data>
</edge>
