  <data key="d4">whole</data>
  <data key="d9">topical</data>
  <data key="d6">πασῶν δὲ κοινῶς ἡ πόα καταπλασθεῖσα λεία αἱμορροΐδας στέλλει, φλεγμονάς τε τὰς κατὰ δακτύλιον πραΰνει καὶ κονδυλώματα καὶ χοιράδας καὶ τὰ δύσπεπτα τῶν ἀποστημάτων συμπέσσει.</data>
  <data key="d7">1b6ae2d7a3ad1b45</data>
</edge>
